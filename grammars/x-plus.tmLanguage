<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>X+</string>
	<key>scopeName</key>
	<string>source.xplus</string>
	<key>fileTypes</key>
	<array>
		<string>xp</string>
	</array>
	<key>uuid</key>
	<string>08b3c26d-4127-4a54-84c9-466ccb273868</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>comment</key>
			<string>Program header: Inject SysMode / Inject X+</string>
			<key>match</key>
			<string>^\s*(Inject)\s+(SysMode|X\+)\b.*$</string>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>keyword.other.inject.xplus</string>
				</dict>
				<key>2</key>
				<dict>
					<key>name</key>
					<string>entity.name.mode.xplus</string>
				</dict>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>string.quoted.double.xplus</string>
			<key>begin</key>
			<string>"</string>
			<key>end</key>
			<string>"</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.character.escape.xplus</string>
					<key>match</key>
					<string>\\[nrt"\\]</string>
				</dict>
			</array>
		</dict>
		<dict>
			<key>name</key>
			<string>comment.line.number-sign.xplus</string>
			<key>match</key>
			<string>#.*$</string>
		</dict>
		<dict>
			<key>name</key>
			<string>comment.line.double-slash.xplus</string>
			<key>match</key>
			<string>//.*$</string>
		</dict>
		<dict>
			<key>name</key>
			<string>constant.numeric.hex.xplus</string>
			<key>match</key>
			<string>\b0[xX][0-9A-Fa-f]+\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>constant.numeric.decimal.xplus</string>
			<key>match</key>
			<string>\b[0-9]+\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>keyword.control.xplus</string>
			<key>match</key>
			<string>\b(if|else|do|end|using|var|set|call|block|func)\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>support.function.builtin.xplus</string>
			<key>match</key>
			<string>\b(vidwrite|vidread|memw|memr|wfkey|wfkeyinp|printstr|printext|inputnum|inputstr)\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>storage.type.xplus</string>
			<key>match</key>
			<string>\b(num|str|byte)\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>entity.other.attribute-name.xplus</string>
			<key>match</key>
			<string>\b(name|main|enc|device|cls|dyn|ascii|true|false|ps2keyb)\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>keyword.operator.xplus</string>
			<key>match</key>
			<string>==|!=|&lt;=|&gt;=|\+|-|\*|/|&lt;|&gt;|=</string>
		</dict>
	</array>
</dict>
</plist>
