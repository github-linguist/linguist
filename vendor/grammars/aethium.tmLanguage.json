{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aethium",
  "scopeName": "source.aethium",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.aethium", "match": "#.*$" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.triple.aethium", "begin": "\"\"\"", "end": "\"\"\"" },
        { "name": "string.quoted.triple.single.aethium", "begin": "'''", "end": "'''" },
        { "name": "string.quoted.double.aethium", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.aethium", "match": "\\\\." }] },
        { "name": "string.quoted.single.aethium", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.aethium", "match": "\\\\." }] }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.aethium", "match": "\\b(if|elif|else|for|while|break|continue|return|yield|try|except|finally|raise|from|with|as|pass|assert|del|global|match|case|async|await|in|is|and|or|not)\\b" },
        { "name": "storage.type.aethium", "match": "\\b(def|class|lambda|spawn|chan)\\b" }
      ]
    },
    "builtins": {
      "patterns": [
        { "name": "support.function.builtin.aethium", "match": "\\b(print|len|range|type|str|int|float|bool|list|dict|set|frozenset|tuple|bytes|bytearray|complex|memoryview|sum|min|max|abs|round|map|filter|zip|enumerate|sorted|reversed|any|all|isinstance|issubclass|repr|ord|chr|hex|bin|oct|pow|id|hash|input|exit|open|next|super|breakpoint|help)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.aethium", "match": "\\b(True|False|None|Ellipsis)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.complex.aethium", "match": "\\b[0-9]+(\\.[0-9]+)?[jJ]\\b" },
        { "name": "constant.numeric.float.aethium", "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b" },
        { "name": "constant.numeric.hex.aethium", "match": "\\b0[xX][0-9a-fA-F]+\\b" },
        { "name": "constant.numeric.octal.aethium", "match": "\\b0[oO][0-7]+\\b" },
        { "name": "constant.numeric.binary.aethium", "match": "\\b0[bB][01]+\\b" },
        { "name": "constant.numeric.integer.aethium", "match": "\\b[0-9]+\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.aethium", "match": "(\\+|-|\\*|/|//|%|\\*\\*|==|!=|<=|>=|<|>|:=|=|<-|->|&|\\||\\^|~|<<|>>)" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.aethium", "match": "\\bdef\\s+([a-zA-Z_][a-zA-Z0-9_]*)" }
      ]
    }
  }
}
