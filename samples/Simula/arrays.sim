program Arrays;
begin
    array[1:5] integer values;
    integer index;
    integer total;
    total := 0;
    for index := 1 step 1 until 5 do
    begin
        values[index] := index * index;
        total := total + values[index];
    end;
    assert(total = 55);
    outint(total);
    outimage;
    exit(0)
end;
