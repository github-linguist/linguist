// Plain v1.0.0 — Conditions and comparisons

remember score as 85

if score is at least 90
    show "A grade"
otherwise
    show "Not an A"
done

if score between 80 and 89
    show "B grade"
done

remember name as "Plain"

if name contains "Plain"
    show "Found it"
done

if name starts with "P"
    show "Starts with P"
done

if name ends with "n"
    show "Ends with n"
done
