// Bucles: rangos y arrays
fn main() {
    var total = 0
    for i in 0..5 {          // 0,1,2,3,4
        total += i
    }
    print(total)             // 10

    var inclusive = 0
    for i in 1...3 {         // 1,2,3
        inclusive += i
    }
    print(inclusive)         // 6

    let nums = [10, 20, 30, 40]
    var sum = 0
    for n in nums {
        sum += n
    }
    print(sum)               // 100

    let names = ["ana", "bob"]
    for name in names {
        print(name)
    }

    var n = 0
    while n < 10 {
        n += 1
        if n == 3 { continue }
        if n == 6 { break }
        print(n)             // 1,2,4,5
    }
}
