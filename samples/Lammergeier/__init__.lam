# Vulture: Fastify-style HTTP server package for Lammergeier.
# Import with: from @lam/vulture import Server, Request, Response
#
# ``Server`` is the counterpart to ``lamhttp.Http`` (client). The API
# was modelled on Fastify: declarative route registration by method,
# a plug-in/extension system, and a lifecycle-hook ladder around each
# request. Everything sits on Go's ``net/http`` so the cost is a thin
# dispatch layer over the stdlib.
#
#     from @lam/vulture import Server, Request, Response
#
#     srv: Server = Server()
#
#     # Hooks fire for every request, in this order:
#     #   onRequest      → right after parsing the request line
#     #   preHandler     → after body parsing, before the route handler
#     #   onResponse     → after the handler, before the bytes go out
#     srv.onRequest(lambda req, res: print(f"[in] {req.method} {req.path}"))
#     srv.onResponse(lambda req, res: res.setHeader("X-Server", "Vulture/1"))
#
#     # Routes — each handler receives (Request, Response) and calls
#     # res.text(...) / res.json(...) to produce output.
#     srv.get("/health", lambda req, res: res.text("ok"))
#     srv.post("/echo",  lambda req, res: res.text(req.body))
#     srv.post("/users", createUser, userSchema)  # automatic body validation
#
#     # ``req.ctx`` keeps dictionary indexing while carrying cancellation,
#     # deadlines, reasons, and inherited values through ``lamcontext.Context``.
#
#     # Plugins are just ``func(Server) -> None`` — they get full
#     # access to the server instance. Register them with ``.register``.
#     func authPlugin(srv: Server) {
#         srv.onRequest(lambda req, res: checkToken(req, res))
#     }
#     srv.register(authPlugin)
#
#     srv.listen(8080)    # blocks until srv.close()
#
# Routing:
#   * Exact-path: ``/foo``
#   * Path parameters: ``/users/:id`` — exposed via ``req.params[":id"]``
#     Any segment starting with ``:`` matches a single path segment.
#   * Multiple methods on the same path are stored separately.
#   * A request that matches no route returns ``404``.
#
# Response short-circuiting:
#   * If a hook calls ``res.setStatus`` or any of ``res.text/json/send``,
#     the response is considered "sent" and no further hooks or the
#     route handler will run. Use this pattern for auth / guards.
#
# Errors inside handlers/hooks are recovered by the server and turned
# into ``500 internal server error``; the panic message is written to
# the response body in debug mode (toggle via ``srv.debug = true``).

from lamcontext import Context
from lamschema import Schema

go! {
    import (
        "context"
        "crypto/hmac"
        "crypto/rand"
        "crypto/sha256"
        "crypto/subtle"
        "crypto/tls"
        "encoding/base64"
        "encoding/hex"
        "encoding/json"
        "errors"
        "fmt"
        "io"
        "mime"
        "mime/multipart"
        "net"
        "net/http"
        "net/url"
        "os"
        "path/filepath"
        "slices"
        "strconv"
        "strings"
        "sync"
        "sync/atomic"
        "time"
    )
}

go! {
    // ─── Internal routing / hook types ──────────────────────
    // A compiled route: method + pattern split into segments, plus a
    // list of positional parameter names in the order they appear.
    //
    // “opts“ is non-nil for routes registered via the *Opts variants
    // and carries per-route configuration (body limit, route-level
    // hooks, OpenAPI metadata).
    type lamRoute struct {
        method   string
        segments []string    // "users", ":id", "posts"
        params   []int       // indices of segments that start with ":"
        handler  interface{} // func(*Request, *Response)
        opts     *lamRouteOpts
    }

    type lamRouteOpts struct {
        BodyLimit        int         // 0 = inherit from server
        PreParsing       interface{} // func(*Request, *Response)
        PreValidation    interface{} // func(*Request, *Response)
        PreHandler       interface{} // func(*Request, *Response), runs after global preHandlers
        PreSerialization interface{} // func(*Request, *Response)
        OnSend           interface{} // func(*Request, *Response)
        OnResponse       interface{} // func(*Request, *Response), runs before global onResponse hooks
        OnError          interface{} // func(*Request, *Response, interface{}), route-level error hook
        // Fastify-style schema. Each entry is the raw schema *text*
        // (so authors can paste JSON Schema as-is); we compile lazily
        // on first request. “ResponseSchemas“ is keyed by status
        // code as a string so 200/4xx/default can have different
        // shapes — Fastify behaves the same way.
        BodySchema      string
        SchemaFormat    string
        QuerySchema     string
        ParamsSchema    string
        HeadersSchema   string
        ResponseSchemas map[string]string
        // Misc metadata that surfaces in “listRoutes“ and the
        // OpenAPI generator.
        OperationId string
        Summary     string
        Description string
        Tags        []string
        Deprecated  bool
        Hidden      bool     // hide from OpenAPI / listRoutes if true
        Consumes    []string // OpenAPI request body media types
        Produces    []string // OpenAPI response media types
        // Per-route handler timeout in milliseconds; “0“ means
        // "inherit from server" (which itself defaults to “0“ =
        // disabled). When non-zero this value supersedes
        // “Server.RequestTimeoutMs“ for the matched route.
        TimeoutMs int
        // Per-route opt-out of buffered body reads. When true, the
        // dispatcher leaves “r.Body“ untouched and stashes it on
        // “req.ctx[__lamBodyReader]“ so the handler can pull
        // chunks via “req.bodyReader()“. “req.body“ stays
        // empty and content-type parsers don't run (they need the
        // whole body anyway). Ideal for large uploads.
        StreamBody bool
        Meta       map[string]interface{} // arbitrary user metadata (echoed back by listRoutes)
    }

    // lamRouteOptsAddPreHandler chains a new preHandler onto the
    // existing one (so encapsulated plugins can stack them without
    // overwriting). Returns the combined fn.
    func lamRouteOptsChain(existing, added interface{}) interface{} {
        if existing == nil {
            return added
        }
        if added == nil {
            return existing
        }
        e, eok := existing.(func(*Request, *Response))
        a, aok := added.(func(*Request, *Response))
        if !eok || !aok {
            return existing
        }
        return func(req *Request, res *Response) {
            e(req, res)
            if res.Sent {
                return
            }
            a(req, res)
        }
    }

    // lamCoerceRouteOpts converts a Lam-side dict / map into the
    // typed “*lamRouteOpts“ the dispatcher expects. Accepts plain
    // “map[string]interface{}“ (the canonical Lam dict type).
    // Unknown keys are stashed under “Meta“.
    //
    // The “schema“ key is consumed specially: a nested dict with
    // “body“ / “querystring“ / “params“ / “headers“ /
    // “response“ slots that mirror Fastify's schema layout. Each
    // sub-value can be either a raw JSON Schema string *or* a
    // “dict[str, any]“ that we re-marshal back to JSON before
    // compiling — the latter is more ergonomic from Lam.
    func lamCoerceRouteOpts(raw interface{}) *lamRouteOpts {
        if raw == nil {
            return nil
        }
        m, ok := raw.(map[string]interface{})
        if !ok || len(m) == 0 {
            return nil
        }
        out := &lamRouteOpts{Meta: map[string]interface{}{}}
        for k, v := range m {
            switch strings.ToLower(k) {
            case "bodylimit":
                if n, ok := v.(int); ok {
                    out.BodyLimit = n
                }
                if n, ok := v.(int64); ok {
                    out.BodyLimit = int(n)
                }
            case "timeoutms", "timeout":
                if n, ok := v.(int); ok {
                    out.TimeoutMs = n
                }
                if n, ok := v.(int64); ok {
                    out.TimeoutMs = int(n)
                }
            case "streambody", "stream":
                if b, ok := v.(bool); ok {
                    out.StreamBody = b
                }
            case "preparsing":
                out.PreParsing = v
            case "prevalidation":
                out.PreValidation = v
            case "prehandler":
                out.PreHandler = v
            case "preserialization":
                out.PreSerialization = v
            case "onsend":
                out.OnSend = v
            case "onresponse":
                out.OnResponse = v
            case "onerror":
                out.OnError = v
            case "operationid":
                if s, ok := v.(string); ok {
                    out.OperationId = s
                }
            case "summary":
                if s, ok := v.(string); ok {
                    out.Summary = s
                }
            case "description":
                if s, ok := v.(string); ok {
                    out.Description = s
                }
            case "deprecated":
                if b, ok := v.(bool); ok {
                    out.Deprecated = b
                }
            case "hidden":
                if b, ok := v.(bool); ok {
                    out.Hidden = b
                }
            case "consumes":
                if list, ok := v.([]interface{}); ok {
                    for _, t := range list {
                        if s, ok := t.(string); ok {
                            out.Consumes = append(out.Consumes, s)
                        }
                    }
                } else if list, ok := v.([]string); ok {
                    out.Consumes = append(out.Consumes, list...)
                }
            case "produces":
                if list, ok := v.([]interface{}); ok {
                    for _, t := range list {
                        if s, ok := t.(string); ok {
                            out.Produces = append(out.Produces, s)
                        }
                    }
                } else if list, ok := v.([]string); ok {
                    out.Produces = append(out.Produces, list...)
                }
            case "tags":
                if list, ok := v.([]interface{}); ok {
                    for _, t := range list {
                        if s, ok := t.(string); ok {
                            out.Tags = append(out.Tags, s)
                        }
                    }
                } else if list, ok := v.([]string); ok {
                    out.Tags = append(out.Tags, list...)
                }
            case "schema":
                lamPopulateSchemaSlots(out, v)
            case "schemaformat":
                if format, ok := v.(string); ok {
                    out.SchemaFormat = format
                }
            default:
                out.Meta[k] = v
            }
        }
        return out
    }

    // lamPopulateSchemaSlots accepts the “schema“ sub-map and
    // populates the appropriate string fields on “out“. Each leaf
    // value may be a JSON-encoded string or a nested map; maps are
    // re-serialised so the on-wire compiler sees JSON Schema text.
    func lamPopulateSchemaSlots(out *lamRouteOpts, raw interface{}) {
        m, ok := raw.(map[string]interface{})
        if !ok {
            return
        }
        toText := func(v interface{}) string {
            if s, ok := v.(string); ok {
                return s
            }
            if b, err := json.Marshal(v); err == nil {
                return string(b)
            }
            return ""
        }
        for k, v := range m {
            switch strings.ToLower(k) {
            case "body":
                out.BodySchema = toText(v)
            case "querystring", "query":
                out.QuerySchema = toText(v)
            case "params":
                out.ParamsSchema = toText(v)
            case "headers":
                out.HeadersSchema = toText(v)
            case "response":
                if rm, ok := v.(map[string]interface{}); ok {
                    if out.ResponseSchemas == nil {
                        out.ResponseSchemas = map[string]string{}
                    }
                    for code, sub := range rm {
                        out.ResponseSchemas[strings.ToLower(code)] = toText(sub)
                    }
                }
            }
        }
    }

    func lamSplitPath(p string) []string {
        if p == "/" || p == "" {
            return []string{""}
        }
        p = strings.TrimPrefix(p, "/")
        p = strings.TrimSuffix(p, "/")
        return strings.Split(p, "/")
    }

    func lamCompileRoute(method, pattern string, handler interface{}) lamRoute {
        return lamCompileRouteWithOpts(method, pattern, handler, nil)
    }

    func lamCompileRouteWithOpts(method, pattern string, handler interface{}, opts *lamRouteOpts) lamRoute {
        segs := lamSplitPath(pattern)
        params := []int{}
        for i, s := range segs {
            if strings.HasPrefix(s, ":") {
                params = append(params, i)
            }
        }
        return lamRoute{
            method:   strings.ToUpper(method),
            segments: segs,
            params:   params,
            handler:  handler,
            opts:     opts,
        }
    }

    func lamMatchRoute(r lamRoute, method string, segs []string) (map[string]string, bool) {
        if r.method != strings.ToUpper(method) {
            return nil, false
        }
        // Wildcard “*“ matches the rest of the path.
        if len(r.segments) > 0 && r.segments[len(r.segments)-1] == "*" {
            if len(segs) < len(r.segments)-1 {
                return nil, false
            }
            params := map[string]string{}
            for i := 0; i < len(r.segments)-1; i++ {
                rs := r.segments[i]
                if strings.HasPrefix(rs, ":") {
                    params[rs] = segs[i]
                    continue
                }
                if rs != segs[i] {
                    return nil, false
                }
            }
            params["*"] = strings.Join(segs[len(r.segments)-1:], "/")
            return params, true
        }
        if len(r.segments) != len(segs) {
            return nil, false
        }
        params := map[string]string{}
        for i, rs := range r.segments {
            if strings.HasPrefix(rs, ":") {
                params[rs] = segs[i]
                continue
            }
            if rs != segs[i] {
                return nil, false
            }
        }
        return params, true
    }

    // ─── Trie router ────────────────────────────────────────
    // Per-method radix-style trie. Each non-leaf node has at most:
    //   - a map of literal children (one per static segment),
    //   - one parametric child (“:name“),
    //   - one wildcard child (“*“) which terminates the walk and
    //     captures the rest of the path.
    //
    // Lookup proceeds segment-by-segment, preferring static > param >
    // wildcard. We also collect path-only matches across methods so
    // the dispatcher can issue 405s for the right URL but the wrong
    // verb. Tries are rebuilt lazily when “Server.Routes“ mutates;
    // the dispatcher falls back to the linear scan if the trie is
    // nil, so route() can defer indexing.
    type lamRouteTrieNode struct {
        literal  map[string]*lamRouteTrieNode
        param    *lamRouteTrieNode
        paramKey string            // e.g. ":id"
        wildcard *lamRouteTrieNode // terminal
        // Method → matched route at this prefix. A node can carry
        // routes for multiple methods (eg “/x“ GET *and* POST).
        leaf map[string]lamRoute
    }

    type lamRouteTrie struct {
        roots map[string]*lamRouteTrieNode // method → root
        // pathIndex maps an exact segment-pattern to the methods that
        // declared it — used for 405 method-not-allowed responses.
        pathIndex map[string]map[string]struct{}
    }

    func newLamRouteTrieNode() *lamRouteTrieNode {
        return &lamRouteTrieNode{
            literal: map[string]*lamRouteTrieNode{},
            leaf:    map[string]lamRoute{},
        }
    }

    func newLamRouteTrie() *lamRouteTrie {
        return &lamRouteTrie{
            roots:     map[string]*lamRouteTrieNode{},
            pathIndex: map[string]map[string]struct{}{},
        }
    }

    func lamTrieInsert(t *lamRouteTrie, r lamRoute) {
        method := strings.ToUpper(r.method)
        root, ok := t.roots[method]
        if !ok {
            root = newLamRouteTrieNode()
            t.roots[method] = root
        }
        node := root
        for i, seg := range r.segments {
            switch {
            case seg == "*":
                if node.wildcard == nil {
                    node.wildcard = newLamRouteTrieNode()
                }
                node = node.wildcard
                // Wildcard absorbs the rest of the path; later
                // segments are ignored at lookup time.
                _ = i
            case strings.HasPrefix(seg, ":"):
                if node.param == nil {
                    node.param = newLamRouteTrieNode()
                    node.paramKey = seg
                }
                node = node.param
            default:
                child, ok := node.literal[seg]
                if !ok {
                    child = newLamRouteTrieNode()
                    node.literal[seg] = child
                }
                node = child
            }
        }
        node.leaf[method] = r
        // Path index for 405s — keyed by the canonical pattern.
        pat := strings.Join(r.segments, "/")
        if t.pathIndex[pat] == nil {
            t.pathIndex[pat] = map[string]struct{}{}
        }
        t.pathIndex[pat][method] = struct{}{}
    }

    // lamTrieMatch walks the per-method trie. Returns the matched
    // route + path-parameters, or (nil, nil, otherMethods) when the
    // path matches some route but for a different method (405).
    func lamTrieMatch(t *lamRouteTrie, method string, segs []string) (*lamRoute, map[string]string, []string) {
        if t == nil {
            return nil, nil, nil
        }
        method = strings.ToUpper(method)
        if root, ok := t.roots[method]; ok {
            params := map[string]string{}
            if r, found := lamTrieWalk(root, segs, 0, params, method); found {
                rcopy := r
                return &rcopy, params, nil
            }
        }
        // Method not found at this exact path → look across all
        // methods to surface a 405 with a useful Allow header.
        var allow []string
        for m, root := range t.roots {
            if m == method {
                continue
            }
            params := map[string]string{}
            if _, ok := lamTrieWalk(root, segs, 0, params, m); ok {
                allow = append(allow, m)
            }
        }
        return nil, nil, allow
    }

    // lamTrieWalk recurses through “node“ at depth “i“, trying
    // literal first, then param, then wildcard. Mutates “params“
    // in place when a parametric edge is taken.
    func lamTrieWalk(node *lamRouteTrieNode, segs []string, i int, params map[string]string, method string) (lamRoute, bool) {
        if node == nil {
            return lamRoute{}, false
        }
        if i == len(segs) {
            if r, ok := node.leaf[method]; ok {
                return r, true
            }
            return lamRoute{}, false
        }
        seg := segs[i]
        // 1) literal child
        if child, ok := node.literal[seg]; ok {
            if r, found := lamTrieWalk(child, segs, i+1, params, method); found {
                return r, true
            }
        }
        // 2) parametric
        if node.param != nil {
            saved := params[node.paramKey]
            params[node.paramKey] = seg
            if r, found := lamTrieWalk(node.param, segs, i+1, params, method); found {
                return r, true
            }
            // Restore on backtrack.
            if saved == "" {
                delete(params, node.paramKey)
            } else {
                params[node.paramKey] = saved
            }
        }
        // 3) wildcard (consumes the rest of the path)
        if node.wildcard != nil {
            if r, ok := node.wildcard.leaf[method]; ok {
                params["*"] = strings.Join(segs[i:], "/")
                return r, true
            }
        }
        return lamRoute{}, false
    }

    // ─── Cookie helpers ────────────────────────────────────────
    //
    // “lamServerBuildCookie“ assembles a “Set-Cookie“ header
    // value honouring the modern attribute set (Path, Domain,
    // Max-Age/Expires, Secure, HttpOnly, SameSite). It delegates
    // to “http.Cookie.String“ so quoting and encoding match
    // whatever the stdlib would emit for a programmatic cookie.
    func lamServerBuildCookie(name, value, path string, maxAge int, domain string,
        secure, httpOnly bool, sameSite string) string {
        c := &http.Cookie{
            Name:     name,
            Value:    value,
            Path:     path,
            Domain:   domain,
            Secure:   secure,
            HttpOnly: httpOnly,
        }
        if maxAge != 0 {
            c.MaxAge = maxAge
            if maxAge < 0 {
                // Belt-and-braces deletion: some browsers ignore
                // Max-Age but still honour Expires in the past.
                c.Expires = time.Unix(0, 0)
            } else {
                c.Expires = time.Now().Add(time.Duration(maxAge) * time.Second)
            }
        }
        switch strings.ToLower(sameSite) {
        case "strict":
            c.SameSite = http.SameSiteStrictMode
        case "lax":
            c.SameSite = http.SameSiteLaxMode
        case "none":
            c.SameSite = http.SameSiteNoneMode
        }
        return c.String()
    }

    // “lamServerAppendCookie“ stacks a new “Set-Cookie“ value on
    // top of whatever is already in the header map. “net/http“'s
    // ResponseWriter path splits on a literal newline to support
    // multiple Set-Cookie entries; we use the same convention.
    func lamServerAppendCookie(existing, next string) string {
        if existing == "" {
            return next
        }
        return existing + "\n" + next
    }

    // ─── Cookie signing helpers ────────────────────────────────
    // HMAC-SHA256 over the raw value, encoded with URL-safe base64.
    // Format on the wire: “<value>.<sig>“ so the cookie is readable
    // without the secret; tampering invalidates the sig.
    func lamCookieSign(value, secret string) string {
        mac := hmac.New(sha256.New, []byte(secret))
        mac.Write([]byte(value))
        sum := mac.Sum(nil)
        return base64.RawURLEncoding.EncodeToString(sum)
    }

    func lamCookieVerify(signed, secret string) (string, bool) {
        // Split on the *last* dot so values containing dots survive.
        idx := strings.LastIndex(signed, ".")
        if idx < 0 {
            return "", false
        }
        value := signed[:idx]
        sig := signed[idx+1:]
        expected := lamCookieSign(value, secret)
        // Constant-time compare to keep timing attacks at bay.
        if subtle.ConstantTimeCompare([]byte(sig), []byte(expected)) != 1 {
            return "", false
        }
        return value, true
    }

    // ─── Multipart helpers ─────────────────────────────────────
    // “lamMultipartFile“ mirrors the structure callers see from
    // “Request.formFile“. Keeping it private here means we can
    // adjust internals freely; the dict shape is what's documented.
    type lamMultipartFile struct {
        Name        string
        Filename    string
        ContentType string
        Size        int
        Content     []byte
    }

    type lamMultipartForm struct {
        Fields map[string][]string
        Files  map[string][]*lamMultipartFile
    }

    func lamParseMultipart(body string, ct string) (*lamMultipartForm, error) {
        _, params, err := mime.ParseMediaType(ct)
        if err != nil {
            return nil, err
        }
        boundary := params["boundary"]
        if boundary == "" {
            return nil, errors.New("multipart: missing boundary")
        }
        reader := multipart.NewReader(strings.NewReader(body), boundary)
        form := &lamMultipartForm{
            Fields: map[string][]string{},
            Files:  map[string][]*lamMultipartFile{},
        }
        for {
            part, err := reader.NextPart()
            if err == io.EOF {
                break
            }
            if err != nil {
                return nil, err
            }
            data, rerr := io.ReadAll(part)
            if rerr != nil {
                return nil, rerr
            }
            if part.FileName() == "" {
                form.Fields[part.FormName()] = append(form.Fields[part.FormName()], string(data))
            } else {
                form.Files[part.FormName()] = append(form.Files[part.FormName()], &lamMultipartFile{
                    Name:        part.FormName(),
                    Filename:    part.FileName(),
                    ContentType: part.Header.Get("Content-Type"),
                    Size:        len(data),
                    Content:     data,
                })
            }
            part.Close()
        }
        return form, nil
    }

    // lamFileToDict materialises a “*lamMultipartFile“ as the
    // public “dict[str, any]“ shape. Content stays as a Go
    // “[]byte“ so binary uploads round-trip without UTF-8 mangling.
    func lamFileToDict(f *lamMultipartFile) map[string]interface{} {
        return map[string]interface{}{
            "name":        f.Name,
            "filename":    f.Filename,
            "contentType": f.ContentType,
            "size":        f.Size,
            "content":     f.Content,
        }
    }

    // ─── Trust-proxy helpers ───────────────────────────────────
    // Strip the port off “addr“ and return just the host. Falls
    // back to the input if it doesn't have a port.
    func lamHostOnly(addr string) string {
        host, _, err := net.SplitHostPort(addr)
        if err != nil {
            return addr
        }
        return host
    }

    // Walk the configured “trustProxyHeaders“ (in order) looking
    // for the first non-empty value; honour “hops“ to choose
    // *which* IP from the comma-separated chain. “hops=1“ returns
    // the rightmost (closest proxy), “hops=N“ returns the Nth from
    // the right. Returns "" if no header matched.
    func lamForwardedClientIP(headers map[string]string, names []string, hops int) string {
        if hops < 1 {
            hops = 1
        }
        for _, name := range names {
            for k, v := range headers {
                if !strings.EqualFold(k, name) {
                    continue
                }
                if v == "" {
                    continue
                }
                parts := strings.Split(v, ",")
                // Rightmost = hop 1 (proxy that talked to us); leftmost
                // = original client (potentially attacker-controlled).
                idx := len(parts) - hops
                if idx < 0 {
                    idx = 0
                }
                ip := strings.TrimSpace(parts[idx])
                if ip != "" {
                    return ip
                }
            }
        }
        return ""
    }

    func lamForwardedScheme(headers map[string]string) string {
        for k, v := range headers {
            if strings.EqualFold(k, "X-Forwarded-Proto") && v != "" {
                if i := strings.Index(v, ","); i > 0 {
                    return strings.TrimSpace(v[:i])
                }
                return strings.TrimSpace(v)
            }
            if strings.EqualFold(k, "Forwarded") && v != "" {
                // RFC 7239: "Forwarded: by=...;for=...;proto=https"
                for _, part := range strings.Split(v, ";") {
                    part = strings.TrimSpace(part)
                    if strings.HasPrefix(strings.ToLower(part), "proto=") {
                        return strings.Trim(part[len("proto="):], "\"")
                    }
                }
            }
        }
        return ""
    }

    // ─── $ref resolution for shared schemas ─────────────────
    // Fastify's “addSchema({ $id: "x", ... })“ is implemented by
    // pre-substituting any “{"$ref": "<id>"}“ in a route schema
    // with the full shared schema text *before* the result hits the
    // compile cache. The resolved text becomes the cache key, so
    // the schema only gets (re)compiled when either (a) the route
    // schema itself changes, or (b) a shared schema the route
    // references changes. Nested refs inside the shared schema are
    // resolved transitively.
    //
    // This implementation handles the common case: bare
    // “{"$ref": "<id>"}“ lookups by $id. Fragment refs
    // (“#/definitions/foo“) are passed through to gojsonschema,
    // which resolves them natively against the top-level schema.
    func lamResolveSchemaRefs(text string, shared map[string]string) string {
        if text == "" || len(shared) == 0 {
            return text
        }
        if !strings.Contains(text, "$ref") {
            return text
        }
        var doc interface{}
        if err := json.Unmarshal([]byte(text), &doc); err != nil {
            return text
        }
        resolved := lamWalkRefs(doc, shared, map[string]bool{})
        b, err := json.Marshal(resolved)
        if err != nil {
            return text
        }
        return string(b)
    }

    func lamMissingSharedSchemaRef(text string, shared map[string]string) bool {
        var schema interface{}
        if err := json.Unmarshal([]byte(text), &schema); err != nil {
            return false
        }
        var missing func(interface{}) bool
        missing = func(value interface{}) bool {
            switch current := value.(type) {
            case map[string]interface{}:
                if ref, ok := current["$ref"].(string); ok && ref != "" && !strings.HasPrefix(ref, "#") {
                    if _, exists := shared[ref]; !exists {
                        return true
                    }
                }
                for _, child := range current {
                    if missing(child) {
                        return true
                    }
                }
            case []interface{}:
                for _, child := range current {
                    if missing(child) {
                        return true
                    }
                }
            }
            return false
        }
        return missing(schema)
    }

    func lamWalkRefs(v interface{}, shared map[string]string,
        seen map[string]bool) interface{} {
        switch x := v.(type) {
        case map[string]interface{}:
            if refId, ok := x["$ref"].(string); ok && refId != "" &&
                !strings.HasPrefix(refId, "#") {
                if sharedText, has := shared[refId]; has {
                    if seen[refId] {
                        // Cycle — leave the ref alone and let
                        // gojsonschema error on compile.
                        return x
                    }
                    seen[refId] = true
                    var sub interface{}
                    if err := json.Unmarshal([]byte(sharedText), &sub); err == nil {
                        resolved := lamWalkRefs(sub, shared, seen)
                        // Strip “$id“ from the inlined shared
                        // schema so gojsonschema doesn't think it's
                        // a nested top-level schema.
                        if m, ok := resolved.(map[string]interface{}); ok {
                            delete(m, "$id")
                            return m
                        }
                        return resolved
                    }
                    delete(seen, refId)
                }
            }
            out := make(map[string]interface{}, len(x))
            for k, vv := range x {
                out[k] = lamWalkRefs(vv, shared, seen)
            }
            return out
        case []interface{}:
            out := make([]interface{}, len(x))
            for i, item := range x {
                out[i] = lamWalkRefs(item, shared, seen)
            }
            return out
        }
        return v
    }

    // ─── OpenAPI helpers ───────────────────────────────────
    // lamSchemaProperties pulls the “properties“ map off a JSON
    // Schema text. Used by openapi() to lift querystring / headers
    // schemas into “parameters“ entries. Returns nil when the
    // schema isn't an object schema.
    func lamSchemaProperties(text string) map[string]interface{} {
        if text == "" {
            return nil
        }
        var doc map[string]interface{}
        if err := json.Unmarshal([]byte(text), &doc); err != nil {
            return nil
        }
        props, ok := doc["properties"].(map[string]interface{})
        if !ok {
            return nil
        }
        return props
    }

    // parseStatusOr200 parses an integer HTTP status from a string
    // (eg “"200"“); falls back to 200 for non-numeric keys
    // (“"2xx"“, “"default"“).
    func parseStatusOr200(s string) int {
        if n, err := strconv.Atoi(s); err == nil {
            return n
        }
        return 200
    }

    // ─── Content-type helpers ──────────────────────────────
    // Strip parameters off a Content-Type and lowercase the type, so
    // “application/json; charset=utf-8“ → “application/json“.
    // Used to look up custom parsers on the dispatcher.
    func lamContentTypeKey(ct string) string {
        if ct == "" {
            return ""
        }
        if i := strings.IndexByte(ct, ';'); i >= 0 {
            ct = ct[:i]
        }
        return strings.ToLower(strings.TrimSpace(ct))
    }

    func lamReadHeader(req *Request, name string) string {
        for k, v := range req.Headers {
            if strings.EqualFold(k, name) {
                return v
            }
        }
        return ""
    }

    // lamBuiltinParse runs the framework's built-in parser for known
    // content types. The result is what “Request.parsedBody()“
    // would return, but we run it once during preParsing so user
    // hooks downstream see the parsed value via “req.ctx["__parsed"]“.
    func lamBuiltinParse(req *Request) (interface{}, bool) {
        ct := lamContentTypeKey(lamReadHeader(req, "Content-Type"))
        switch ct {
        case "application/json":
            if req.Body == "" {
                return nil, true
            }
            var out interface{}
            if err := json.Unmarshal([]byte(req.Body), &out); err != nil {
                return nil, false
            }
            return out, true
        case "application/x-www-form-urlencoded":
            vals, err := url.ParseQuery(req.Body)
            if err != nil {
                return map[string]string{}, true
            }
            out := map[string]string{}
            for k, vs := range vals {
                if len(vs) > 0 {
                    out[k] = vs[0]
                }
            }
            return out, true
        case "text/plain", "text/html":
            return req.Body, true
        }
        return nil, false
    }

    // lamHeadersAsLowerMap normalises headers for schema lookup
    // (JSON-Schema is case-sensitive on property names; HTTP headers
    // aren't, so we lowercase before validating).
    func lamHeadersAsLowerMap(m map[string]string) map[string]interface{} {
        out := make(map[string]interface{}, len(m))
        for k, v := range m {
            out[strings.ToLower(k)] = v
        }
        return out
    }

    func lamParamsForSchema(m map[string]string) map[string]interface{} {
        out := make(map[string]interface{}, len(m))
        for k, v := range m {
            out[strings.TrimPrefix(k, ":")] = v
        }
        return out
    }

    func lamQueryForSchema(m map[string]string) map[string]interface{} {
        out := make(map[string]interface{}, len(m))
        for k, v := range m {
            out[k] = v
        }
        return out
    }

    // ─── Request-ID helper ─────────────────────────────────
    var lamReqIdCounter uint64

    // lamGenReqId returns a 16-hex-character ID that's monotonic
    // within a process and seeded with crypto/rand for uniqueness
    // across processes. Cheap enough to call per request.
    func lamGenReqId() string {
        n := atomic.AddUint64(&lamReqIdCounter, 1)
        var rnd [4]byte
        _, _ = rand.Read(rnd[:])
        return fmt.Sprintf("%012x%s", n&0xFFFFFFFFFFFF, hex.EncodeToString(rnd[:]))
    }

    // ─── HttpError surface ─────────────────────────────────
    // The Lam-side “HttpError“ class lowers to a Go struct of the
    // same name. We need a tiny helper to introspect it from inside
    // the dispatcher without a dependency on the generated reflect
    // metadata.
    type lamHttpErrorView struct {
        Status  int
        Message string
        Data    interface{}
    }

    // lamExtractHttpError tries to pull a *HttpError out of an
    // arbitrary panic value. Returns ok=false when the panic isn't
    // one of ours.
    func lamExtractHttpError(v interface{}) (lamHttpErrorView, bool) {
        if v == nil {
            return lamHttpErrorView{}, false
        }
        if he, ok := v.(*HttpError); ok && he != nil {
            return lamHttpErrorView{Status: he.Status, Message: he.Message, Data: he.Data}, true
        }
        if he, ok := v.(HttpError); ok {
            return lamHttpErrorView{Status: he.Status, Message: he.Message, Data: he.Data}, true
        }
        return lamHttpErrorView{}, false
    }
}

class RequestBodyReader {
    #- Incremental reader over an incoming request body. Obtain one
    via ``req.bodyReader()``. Works on both streamed routes
    (``routeOpts( {"streamBody": true})``, where the reader pulls
    chunks directly off the TCP connection) and buffered routes
    (wraps ``req.body`` in a ``strings.Reader`` so the API shape
    is uniform).

    Typical shape for a large - upload handler::

    func upload(req, res) {
        r = req.bodyReader()
        total = 0
        while true {
            chunk = r.read(8192)
            if chunk == "" {
                break
            }
            total = total + len(chunk)
            # … sink chunk to disk / network …
        }
        r.close()
        res.json( {"bytes": total})
    }

    ``close()`` is idempotent and optional — the server drains
    and closes the underlying connection once the handler
    returns, so forgetting to call it won't leak FDs (but it's
    good form to call it once you're done). -#

    func __init__(self, reader: any) {
        self.rawReader: any = reader
        self.closed: bool = false
        self.eof: bool = false
    }

    func read(self, maxBytes: int = 8192) -> str {
        #- Read up to ``maxBytes`` bytes. Returns an empty string
        on EOF(and on every subsequent call). Never returns a
        partial UTF - 8 rune on purpose — it's just a byte slice
        cast to string, which matches ``req.body`` semantics. -  #
        out: str = ""
        go! {
            if s.Closed || s.Eof {
                return out
            }
            reader, ok := s.RawReader.(io.Reader)
            if !ok {
                s.Eof = true
                return out
            }
            limit := int(maxBytes)
            if limit <= 0 {
                limit = 8192
            }
            buf := make([]byte, limit)
            n, err := reader.Read(buf)
            if n > 0 {
                out = string(buf[:n])
            }
            if err == io.EOF {
                s.Eof = true
            } else if err != nil {
                // Surface “http.MaxBytesError“ as a 413 panic so
                // the existing error-handler pipeline wraps it; any
                // other read error stops the stream and returns
                // whatever we already captured.
                var mbe *http.MaxBytesError
                if errors.As(err, &mbe) {
                    panic(NewHttpError(413, "payload too large", nil))
                }
                s.Eof = true
            }
        }
        return out
    }

    func readAll(self) -> str {
        #- Drain the reader into a single string. Equivalent to a
        ``read`` loop
        handy when you've opted into streaming
        but the body turns out to be small enough to buffer. -  #
        out: str = ""
        go! {
            if s.Closed || s.Eof {
                return out
            }
            reader, ok := s.RawReader.(io.Reader)
            if !ok {
                s.Eof = true
                return out
            }
            data, err := io.ReadAll(reader)
            if err != nil {
                var mbe *http.MaxBytesError
                if errors.As(err, &mbe) {
                    panic(NewHttpError(413, "payload too large", nil))
                }
            }
            s.Eof = true
            out = string(data)
        }
        return out
    }

    func copyTo(self, path: str) -> int {
        #- Stream the body straight to ``path`` on disk (created
        with ``0644`` perms, truncated if it exists). Returns
        the number of bytes written. Raises via ``HttpError``
        on a body - limit breach
        other IO errors return the
        bytes written so far. -  #
        total: int = 0
        go! {
            if s.Closed || s.Eof {
                return total
            }
            reader, ok := s.RawReader.(io.Reader)
            if !ok {
                s.Eof = true
                return total
            }
            f, err := os.Create(path)
            if err != nil {
                s.Eof = true
                return total
            }
            defer f.Close()
            n, err := io.Copy(f, reader)
            total = int(n)
            if err != nil {
                var mbe *http.MaxBytesError
                if errors.As(err, &mbe) {
                    panic(NewHttpError(413, "payload too large", nil))
                }
            }
            s.Eof = true
        }
        return total
    }

    func close(self) {
        #- Release the underlying reader. Safe to call multiple
        times. After close, ``read`` / ``readAll`` / ``copyTo``
        all return empty / zero. -  #
        go! {
            if s.Closed {
                return
            }
            s.Closed = true
            if c, ok := s.RawReader.(io.Closer); ok {
                _ = c.Close()
            }
        }
    }

    func isEOF(self) -> bool {
        #- ``true`` after the reader hit EOF or was closed. -#
        return self.eof or self.closed
    }
}

class Request {
    #- Incoming HTTP request. Fields are populated by the server before
    any hook runs
    handlers and hooks only read them. -  #

    func __init__(self) {
        self.method: str = ""
        self.path: str = ""
        self.body: str = ""
        self.headers: dict[str, str] = {}
        self.query: dict[str, str] = {}
        self.params: dict[str, str] = {}
        self.remoteAddr: str = ""
        self.ctx: Context = Context.simple()
        # Internal-only slots populated by the HTTP dispatcher; they
        # stay None on the inject() path. Streaming handlers (sse /
        # file streams) and websocket upgrades reach for these.
        self.rawWriter: any = None
        self.rawHttp: any = None
        # ``streamBody`` flag (mirrored from the matched route opts)
        # tells the dispatcher not to buffer the body — it leaves
        # ``self.body`` empty and hands the raw ``r.Body`` reader to
        # ``bodyReader()`` so the handler can stream chunks. Useful
        # for large uploads or server-sent chunked ingest where you
        # don't want to materialise the whole payload in memory.
        self.streamBody: bool = false
    }

    func header(self, name: str) -> str {
        #- Case-insensitive header lookup. Returns "" if absent. -#
        needle: str = name.toLower()
        for key in self.headers {
            if key.toLower() == needle {
                return self.headers[key]
            }
        }
        return ""
    }

    func queryGet(self, name: str, fallback: str = "") -> str {
        #- Read a query-string value with a default. Equivalent to
        ``req.query[name] if name in req.query else fallback``. -  #
        if name in self.query {
            return self.query[name]
        }
        return fallback
    }

    func cookie(self, name: str) -> str {
        #- Read a single cookie value from the ``Cookie`` header.
        Returns "" if the cookie is absent. -  #
        go! {
            raw := ""
            for k, v := range s.Headers {
                if strings.EqualFold(k, "Cookie") {
                    raw = v
                    break
                }
            }
            if raw == "" {
                return ""
            }
            for _, part := range strings.Split(raw, ";") {
                kv := strings.SplitN(strings.TrimSpace(part), "=", 2)
                if len(kv) == 2 && kv[0] == name {
                    return kv[1]
                }
            }
            return ""
        }
    }

    func jsonBody(self) -> json {
        #- Parse ``self.body`` as a native json value. Returns JSON null
        on an empty or malformed body
        use ``req.body`` for raw text. -  #
        go! {
            if s.Body == "" {
                return lamJSONMust(nil)
            }
            parsed, err := lamJSONParse(s.Body)
            if err != nil {
                return lamJSONMust(nil)
            }
            return parsed
        }
    }

    func bodyReader(self) -> RequestBodyReader {
        #- Return a :class:`RequestBodyReader` over the request body.

        * On a route that opted into streaming
        (``routeOpts( {"streamBody": true})``) the reader pulls
        chunks straight off the TCP connection — ``req.body``
        is ``""`` and content - type parsers never run.
        * On a regular buffered route the reader wraps
        ``req.body`` in a ``strings.Reader`` so handlers can
        use the same streaming API regardless of how the
        route was configured.

        Safe to call multiple times — each call hands back a
        fresh reader positioned at the start of the body.
        Streamed reads past EOF return ``""``
        buffered reads
        do too, since ``strings.Reader`` honours ``io.EOF``. -  #
        rawReader: any = None
        go! {
            if raw := s.Ctx.Get("__lamBodyReader", nil); raw != nil {
                if rd, ok := raw.(io.Reader); ok {
                    rawReader = rd
                }
            }
            if rawReader == nil {
                rawReader = strings.NewReader(s.Body)
            }
        }
        return RequestBodyReader(rawReader)
    }

    func parsedBody(self) -> any {
        #- Parse ``self.body`` according to ``Content-Type``:
        * ``application / json`` → native ``json``
        * ``application / x - www - form - urlencoded`` → ``dict[str, str]``
        * ``text / * `` → raw ``str``
        * anything else → raw ``str`` body
        Returns ``None`` only when JSON parsing fails. -  #
        go! {
            ct := ""
            for k, v := range s.Headers {
                if strings.EqualFold(k, "Content-Type") {
                    ct = v
                    break
                }
            }
            ctLower := strings.ToLower(ct)
            switch {
            case strings.Contains(ctLower, "application/json"):
                if s.Body == "" {
                    return nil
                }
                parsed, err := lamJSONParse(s.Body)
                if err != nil {
                    return nil
                }
                return parsed
            case strings.Contains(ctLower, "application/x-www-form-urlencoded"):
                vals, err := url.ParseQuery(s.Body)
                if err != nil {
                    return map[string]string{}
                }
                out := map[string]string{}
                for k, vs := range vals {
                    if len(vs) > 0 {
                        out[k] = vs[0]
                    }
                }
                return out
            default:
                return s.Body
            }
        }
    }

    func signedCookie(self, name: str, secret: str) -> str {
        #- Read ``name`` from the cookie jar and verify the HMAC sig
        produced by ``Response.signedCookie``. Returns the original
        value on a successful verify, or ``""`` on tamper / missing
        cookie / mismatched secret. Constant - time compare. -  #
        raw: str = self.cookie(name)
        if raw == "" {
            return ""
        }
        go! {
            if v, ok := lamCookieVerify(raw, secret); ok {
                return v
            }
            return ""
        }
    }

    func formField(self, name: str, fallback: str = "") -> str {
        #- Read a ``multipart/form-data`` field. Returns ``fallback``
        if the field is absent or the body isn't multipart. The
        parsed form is cached on the request so repeated reads
        don't re-parse. -#
        out: str = fallback
        go! {
            ct := ""
            for k, v := range s.Headers {
                if strings.EqualFold(k, "Content-Type") {
                    ct = v
                    break
                }
            }
            if strings.HasPrefix(strings.ToLower(ct), "multipart/form-data") {
                form, ok := s.Ctx.Get("__lamMultipart", nil).(*lamMultipartForm)
                if !ok {
                    if f, err := lamParseMultipart(s.Body, ct); err == nil {
                        s.Ctx.Set("__lamMultipart", f)
                        form = f
                        ok = true
                    }
                }
                if ok {
                    if values, ok := form.Fields[name]; ok && len(values) > 0 {
                        out = values[0]
                    }
                }
            }
        }
        return out
    }

    func formFile(self, name: str) -> any {
        #- Read the *first* file uploaded under field ``name``. Returns
        ``None`` if the part isn't present or the body isn't
        multipart. The returned dict has keys ``name``, ``filename``,
        ``contentType``, ``size``, and ``content``(raw bytes). -  #
        out: any = None
        go! {
            ct := ""
            for k, v := range s.Headers {
                if strings.EqualFold(k, "Content-Type") {
                    ct = v
                    break
                }
            }
            if strings.HasPrefix(strings.ToLower(ct), "multipart/form-data") {
                form, ok := s.Ctx.Get("__lamMultipart", nil).(*lamMultipartForm)
                if !ok {
                    if f, err := lamParseMultipart(s.Body, ct); err == nil {
                        s.Ctx.Set("__lamMultipart", f)
                        form = f
                        ok = true
                    }
                }
                if ok {
                    if files, ok := form.Files[name]; ok && len(files) > 0 {
                        out = lamFileToDict(files[0])
                    }
                }
            }
        }
        return out
    }

    func formFiles(self, name: str) -> list[any] {
        #- Read *every* file uploaded under field ``name`` (single
        HTML inputs with ``multiple`` produce more than one). -  #
        out: list[any] = []
        go! {
            ct := ""
            for k, v := range s.Headers {
                if strings.EqualFold(k, "Content-Type") {
                    ct = v
                    break
                }
            }
            if strings.HasPrefix(strings.ToLower(ct), "multipart/form-data") {
                form, ok := s.Ctx.Get("__lamMultipart", nil).(*lamMultipartForm)
                if !ok {
                    if f, err := lamParseMultipart(s.Body, ct); err == nil {
                        s.Ctx.Set("__lamMultipart", f)
                        form = f
                        ok = true
                    }
                }
                if ok {
                    if files, ok := form.Files[name]; ok {
                        acc := make([]interface{}, 0, len(files))
                        for _, f := range files {
                            acc = append(acc, lamFileToDict(f))
                        }
                        out = acc
                    }
                }
            }
        }
        return out
    }

    func realIP(self) -> str {
        #- Return the originating client IP, taking the server's
        ``trustProxy`` configuration into account. Falls back to
        ``self.remoteAddr``(host part) when no trusted forwarded
        header was found.

        ** Security **: only meaningful if ``Server.trustProxy(...)``
        was called with header names you actually trust. By default
        this is disabled and you'll always get the direct peer's
        address, which is what you want for a public - facing server. -  #
        go! {
            // Trust-proxy config is stored on the request's ctx by
            // the dispatcher (no schema change to Request needed).
            if names, ok := s.Ctx.Get("__lamTrustHeaders", nil).([]string); ok {
                hops := 1
                if h, ok := s.Ctx.Get("__lamTrustHops", nil).(int); ok && h > 0 {
                    hops = h
                }
                if ip := lamForwardedClientIP(s.Headers, names, hops); ip != "" {
                    return ip
                }
            }
            return lamHostOnly(s.RemoteAddr)
        }
    }

    func realScheme(self, fallback: str = "http") -> str {
        #- Return ``"http"`` or ``"https"`` taking forwarded headers
        into account when ``trustProxy`` is enabled. Falls back to
        ``fallback`` if no header matched. -  #
        go! {
            if _, ok := s.Ctx.Get("__lamTrustHeaders", nil).([]string); ok {
                if scheme := lamForwardedScheme(s.Headers); scheme != "" {
                    return scheme
                }
            }
            // The dispatcher sets “__lamReqScheme“ on the HTTP path
            // when the connection's TLS is set; on the inject path
            // we just return the fallback.
            if v, ok := s.Ctx.Get("__lamReqScheme", nil).(string); ok && v != "" {
                return v
            }
            return fallback
        }
    }

    # ─── Decorators ────────────────────────────────────────
    func dec(self, name: str) -> any {
        #- Read a decorator visible on this request. Lookup order:
        request - level(``Server.decorateRequest``) → server - level
        (``Server.decorate``). This mirrors Fastify's
        ``request.server. < name > `` shortcut so handlers can reach
        any scope through the request alone. Returns ``None`` if
        the decorator was never registered. -  #
        go! {
            if decs, ok := s.Ctx.Get("__lamReqDecorators", nil).(map[string]interface{}); ok {
                if v, has := decs[name]; has {
                    return v
                }
            }
            if decs, ok := s.Ctx.Get("__lamServerDecorators", nil).(map[string]interface{}); ok {
                if v, has := decs[name]; has {
                    return v
                }
            }
            return nil
        }
    }

    func hasDec(self, name: str) -> bool {
        #- ``true`` iff a decorator named ``name`` is reachable from
        this request(request - level or server - level). -  #
        go! {
            if decs, ok := s.Ctx.Get("__lamReqDecorators", nil).(map[string]interface{}); ok {
                if _, has := decs[name]; has {
                    return true
                }
            }
            if decs, ok := s.Ctx.Get("__lamServerDecorators", nil).(map[string]interface{}); ok {
                _, has := decs[name]
                return has
            }
            return false
        }
    }

    func id(self) -> str {
        #- Return this request's ID (set by the request-ID plugin or by
        a custom ``preParsing`` hook). Falls back to ``""`` when no
        ID was assigned. Convenience over ``req.ctx["__lamReqId"]``
        so handlers don't have to know the magic key. -#
        go! {
            if v, ok := s.Ctx.Get("__lamReqId", nil).(string); ok {
                return v
            }
            return ""
        }
    }

    func setId(self, value: str) {
        #- Assign a request ID. Anything inside the dispatcher (logger,
        onError, onSend) reads it back via ``req.id()``. -  #
        self.ctx.set("__lamReqId", value)
    }

    # ─── Fastify-parity sugar ──────────────────────────────
    func protocol(self) -> str {
        #- Fastify-style alias for :py:meth:`realScheme`. Returns
        ``"http"`` or ``"https"`` taking ``trustProxy`` into
        account. Falls back to ``"http"`` when no forwarded
        header is set and the connection's TLS bit is unknown. -#
        return self.realScheme("http")
    }

    func hostname(self) -> str {
        #- Return the request's target host *without* the port,
        taken from the ``Host`` header. Returns ``""`` if the
        header is absent. Mirrors Fastify's
        ``request.hostname``. -  #
        go! {
            for k, v := range s.Headers {
                if strings.EqualFold(k, "Host") {
                    return lamHostOnly(v)
                }
            }
            return ""
        }
    }

    func ips(self) -> list[str] {
        #- Return the full forwarded-client chain when
        ``trustProxy`` is enabled, oldest - first. The last entry
        is always the direct peer's address (``self.remoteAddr``
        minus the port). When trust - proxy is off, returns a
        single - element list with just the peer. Mirrors
        Fastify's ``request.ips`` property.

        Example with ``X - Forwarded - For: 1.1.1.1, 2.2.2.2``:
        * trust - proxy on → ``["1.1.1.1", "2.2.2.2", "<peer>"]``
        * trust - proxy off → ``["<peer>"]`` -  #
        out: list[str] = []
        go! {
            acc := []string{}
            if names, ok := s.Ctx.Get("__lamTrustHeaders", nil).([]string); ok {
                for _, name := range names {
                    for k, v := range s.Headers {
                        if !strings.EqualFold(k, name) || v == "" {
                            continue
                        }
                        // Forwarded (RFC 7239) vs X-Forwarded-For.
                        if strings.EqualFold(name, "Forwarded") {
                            for _, part := range strings.Split(v, ",") {
                                for _, kv := range strings.Split(part, ";") {
                                    kv = strings.TrimSpace(kv)
                                    if strings.HasPrefix(strings.ToLower(kv), "for=") {
                                        acc = append(acc,
                                            strings.Trim(kv[4:], `"[]`))
                                    }
                                }
                            }
                            continue
                        }
                        for _, ip := range strings.Split(v, ",") {
                            if ip = strings.TrimSpace(ip); ip != "" {
                                acc = append(acc, ip)
                            }
                        }
                    }
                }
            }
            acc = append(acc, lamHostOnly(s.RemoteAddr))
            out = acc
        }
        return out
    }

    func routeOptions(self) -> dict[str, any] {
        #- Return the matched route's metadata as a dict — the same
        keys ``Server.listRoutes()`` emits(``method``, ``path``,
        ``summary``, ``tags``, ``meta``, ``operationId``,
        ``deprecated``, ``hidden``, ``consumes``, ``produces``).
        Returns an empty dict when no route matched(eg static
        mounts, 404s, or hook - short - circuited requests).

        Useful for generic middleware: a tracing hook can read
        ``req.routeOptions()["operationId"]`` without the
        handler having to plumb the value through. -  #
        out: dict[str, any] = {}
        go! {
            route, ok := s.Ctx.Get("__lamMatchedRoute", nil).(*lamRoute)
            if !ok || route == nil {
                return out
            }
            o := route.opts
            pattern := "/" + strings.Join(route.segments, "/")
            if pattern == "/" && len(route.segments) == 1 && route.segments[0] == "" {
                pattern = "/"
            }
            m := map[string]interface{}{
                "method": route.method,
                "path":   pattern,
            }
            if o != nil {
                m["summary"] = o.Summary
                m["description"] = o.Description
                m["operationId"] = o.OperationId
                m["deprecated"] = o.Deprecated
                m["hidden"] = o.Hidden
                m["tags"] = append([]string{}, o.Tags...)
                m["consumes"] = append([]string{}, o.Consumes...)
                m["produces"] = append([]string{}, o.Produces...)
                m["timeoutMs"] = o.TimeoutMs
                m["streamBody"] = o.StreamBody
                meta := map[string]interface{}{}
                for k, v := range o.Meta {
                    meta[k] = v
                }
                m["meta"] = meta
            } else {
                m["summary"] = ""
                m["description"] = ""
                m["operationId"] = ""
                m["deprecated"] = false
                m["hidden"] = false
                m["tags"] = []string{}
                m["consumes"] = []string{}
                m["produces"] = []string{}
                m["timeoutMs"] = 0
                m["streamBody"] = false
                m["meta"] = map[string]interface{}{}
            }
            out = m
        }
        return out
    }

    func startTime(self) -> int {
        #- Unix milliseconds captured the moment the dispatcher
        first saw this request. Subtract from the current time
        inside a late hook to measure total latency, or call
        : py: meth: `Response.elapsedTime` from the response side
        for the same result. Returns 0 when the dispatcher
        didn't run (eg synthetic requests). -#
        go! {
            if v, ok := s.Ctx.Get("__lamReqStart", nil).(time.Time); ok {
                return int(v.UnixMilli())
            }
            return 0
        }
    }

    func routerPath(self) -> str {
        #- Pattern string of the route that matched this request, e.g.
        `` / users /: id``. Returns ``""`` when no route matched(404
        path, OPTIONS short - circuit, …). Mirrors Fastify's
        ``req.routerPath``. -  #
        go! {
            route, ok := s.Ctx.Get("__lamMatchedRoute", nil).(*lamRoute)
            if !ok || route == nil {
                return ""
            }
            // Reconstruct the pattern from the compiled segments. The
            // root “/“ is split into a single empty segment — recognise
            // that shape explicitly.
            if len(route.segments) == 1 && route.segments[0] == "" {
                return "/"
            }
            return "/" + strings.Join(route.segments, "/")
        }
    }

    func routerMethod(self) -> str {
        #- HTTP method stored on the matched route (normalised upper-
        case). Returns ``""`` when no route matched. Mirrors
        Fastify's ``req.routerMethod``. -#
        go! {
            route, ok := s.Ctx.Get("__lamMatchedRoute", nil).(*lamRoute)
            if !ok || route == nil {
                return ""
            }
            return route.method
        }
    }

    func is_(self, type_: str) -> bool {
        #- ``true`` iff the request's ``Content-Type`` contains
        ``type_``(case - insensitive, substring match — matches
        Fastify's ``req.is(type)`` semantics, which accepts either
        a full media type like ``"application/json"`` or a short
        form like ``"json"``). Returns ``false`` when no
        ``Content - Type`` header is set. -  #
        contentType: str = self.header("Content-Type")
        if contentType == "" {
            return false
        }
        return contentType.toLower().contains(type_.toLower())
    }

    func url(self) -> str {
        #- Reconstruct a usable URL for this request as
        `` < scheme >: // < host > < path > [?query]``. Honours ``trustProxy``
        when set(forwarded scheme / host), otherwise falls back to
        ``http`` + ``Host`` header. Useful for redirects, link
        headers, and logging. Mirrors Fastify's ``req.url``
        behaviour combined with the host reconstruction that
        ``fullUrl`` helpers expose in express - style frameworks. -  #
        go! {
            scheme := "http"
            for k, v := range s.Headers {
                if strings.EqualFold(k, "X-Forwarded-Proto") && v != "" {
                    if i := strings.Index(v, ","); i > 0 {
                        scheme = strings.TrimSpace(v[:i])
                    } else {
                        scheme = strings.TrimSpace(v)
                    }
                    break
                }
            }
            host := ""
            for k, v := range s.Headers {
                if strings.EqualFold(k, "Host") {
                    host = v
                    break
                }
            }
            qs := ""
            if len(s.Query) > 0 {
                parts := []string{}
                keys := []string{}
                for k := range s.Query {
                    keys = append(keys, k)
                }
                slices.Sort(keys)
                for _, k := range keys {
                    parts = append(parts,
                        url.QueryEscape(k)+"="+url.QueryEscape(s.Query[k]))
                }
                qs = "?" + strings.Join(parts, "&")
            }
            return scheme + "://" + host + s.Path + qs
        }
    }
}

class Response {
    #- Outgoing HTTP response. Handlers / hooks mutate this; the server
    serialises it to the wire exactly once, after the last hook
    runs(or early, if something called .text / .json / .send). -  #

    func __init__(self) {
        self.status: int = 200
        self.headers: dict[str, str] = {}
        self.body: str = ""
        self.sent: bool = false
        # Streaming: when streamHandler is set, the dispatcher writes
        # status + headers, then hands the bare ResponseWriter to the
        # handler. streamFallback gives the inject() path something
        # body-shaped without re-opening the source.
        self.streamHandler: any = None
        self.streamFallback: any = None
        self.sseHandler: any = None
        # Set to true when a handler hijacks the connection (eg
        # WebSocket upgrade); the dispatcher then skips header / body
        # emission and never touches the writer again.
        self.hijacked: bool = false
        # HTTP/2 server pushes queued by ``push()``. The dispatcher
        # walks these on the HTTP path and triggers them via
        # ``http.Pusher`` if available.
        self.pushes: list[any] = []
        # Per-response scratch space. The dispatcher stashes the
        # response-decorator map here under ``__lamRespDecorators``
        # so ``res.dec(name)`` can read it back.  Plugins are free
        # to write their own keys (use a ``__`` prefix to avoid
        # clashing with the framework).
        self.ctx: dict[str, any] = {}
    }

    func setStatus(self, code: int) -> Response {
        self.status = code
        return self
    }

    func code(self, n: int) -> Response {
        #- Fastify-compatible alias for ``setStatus``. Mirrors
        ``reply.code(201).send(payload)`` in Fastify handlers. -  #
        self.status = n
        return self
    }

    func setHeader(self, name: str, value: str) -> Response {
        self.headers[name] = value
        return self
    }

    func header(self, name: str, value: str) -> Response {
        #- Fastify-style alias for ``setHeader``. Returns self so
        ``res.header("X-A", "1").header("X-B", "2").send(...)``
        composes naturally. -  #
        self.headers[name] = value
        return self
    }

    func type_(self, contentType: str) -> Response {
        #- Shortcut for ``setHeader("Content-Type", ct)``. Named with a
        trailing underscore because ``type`` is a Python / Lam keyword. -  #
        self.headers["Content-Type"] = contentType
        return self
    }

    func text(self, body: str) -> Response {
        #- Set ``Content-Type: text/plain`` and write ``body``. -#
        self.headers["Content-Type"] = "text/plain; charset=utf-8"
        self.body = body
        self.sent = true
        return self
    }

    func json(self, obj: json) -> Response {
        #- Marshal a native json value and send it with the JSON content type. -#
        go! {
            b, err := json.Marshal(obj)
            if err != nil {
                s.Status = 500
                s.Body = fmt.Sprintf(`{"error":"json marshal: %v"}`, err)
                s.Sent = true
                return s
            }
            if s.Headers == nil {
                s.Headers = map[string]string{}
            }
            s.Headers["Content-Type"] = "application/json"
            s.Body = string(b)
            s.Sent = true
            return s
        }
    }

    func send(self, body: str) -> Response {
        #- Low-level write: uses whatever Content-Type is already set,
        or ``application / octet - stream`` if none. -  #
        self.body = body
        self.sent = true
        return self
    }

    func html(self, body: str) -> Response {
        #- Set ``Content-Type: text/html`` and write ``body``. -#
        self.headers["Content-Type"] = "text/html; charset=utf-8"
        self.body = body
        self.sent = true
        return self
    }

    func redirect(self, url: str, code: int = 302) -> Response {
        #- Issue an HTTP redirect by setting ``Location`` and the
        response status(302 by default
        use 301 for permanent). -  #
        self.status = code
        self.headers["Location"] = url
        self.body = ""
        self.sent = true
        return self
    }

    func paginate(self, total: int, page: int, perPage: int, basePath: str = "") -> Response {
        #- Attach RFC 5988 pagination headers for a paginated list
        response. Sets:

        * ``X - Total - Count`` — ``total``.
        * ``X - Pagination - Page`` — ``page``.
        * ``X - Pagination - Per - Page`` — ``perPage``.
        * ``X - Pagination - Total - Pages`` — ``ceil(total / perPage)``.
        * ``Link`` — ``first`` / ``prev`` / ``next`` / ``last``
        entries(only those that apply to the current page),
        each of the form `` < basePath?page = N & per_page = M >
        rel = "<role>"``.

        ``basePath`` defaults to the current request's path (read
        from ``self.ctx["__lamReqPath"]`` if the dispatcher set it,
        else ``""``). Handlers can override it to generate
        absolute URLs.

        Does * not * touch ``self.body`` — pair with ``res.json(...)``
        or ``res.send(...)`` to emit the page payload. -  #
        if perPage <= 0 {
            perPage = 1
        }
        if page < 1 {
            page = 1
        }
        self.headers["X-Total-Count"] = str(total)
        self.headers["X-Pagination-Page"] = str(page)
        self.headers["X-Pagination-Per-Page"] = str(perPage)
        totalPages: int = (total + perPage - 1) / perPage
        if totalPages < 1 {
            totalPages = 1
        }
        self.headers["X-Pagination-Total-Pages"] = str(totalPages)
        path: str = basePath
        if path == "" {
            go! {
                if v, ok := s.Ctx["__lamReqPath"].(string); ok {
                    path = v
                }
            }
        }
        separator: str = "?"
        if path.contains("?") {
            separator = "&"
        }
        links: list[str] = []
        if totalPages > 1 {
            links.append(f"<{path}{separator}page=1&per_page={perPage}>; rel=\"first\"")
            links.append(f"<{path}{separator}page={totalPages}&per_page={perPage}>; rel=\"last\"")
        }
        if page > 1 {
            previous: int = page - 1
            links.append(f"<{path}{separator}page={previous}&per_page={perPage}>; rel=\"prev\"")
        }
        if page < totalPages {
            following: int = page + 1
            links.append(f"<{path}{separator}page={following}&per_page={perPage}>; rel=\"next\"")
        }
        if len(links) > 0 {
            self.headers["Link"] = ", ".join(links)
        }
        return self
    }

    func cookie(self, name: str, value: str, path: str = "/", maxAge: int = 0,
    domain: str = "", secure: bool = false, httpOnly: bool = false,
    sameSite: str = "") -> Response {
        #- Append a ``Set-Cookie`` header with the modern attribute
        set. ``maxAge`` 0 means a session cookie
        positive values
        use ``Max - Age = < n > ``
        negative values delete the cookie by
        setting both ``Max - Age = - 1`` and ``Expires`` in the past.

        ``sameSite`` accepts ``"Strict"``, ``"Lax"``, or
        ``"None"``
        anything else(incl. the empty default) is
        left out so the browser picks its own default. ``None``
        without ``Secure`` is silently rejected by browsers, so
        pass both together for cross - site cookies. -  #
        go! {
            s.Headers["Set-Cookie"] = lamServerAppendCookie(
                s.Headers["Set-Cookie"],
                lamServerBuildCookie(name, value, path, maxAge, domain, secure, httpOnly, sameSite),
            )
            return s
        }
    }

    func clearCookie(self, name: str, path: str = "/", domain: str = "") -> Response {
        #- Convenience for deleting a cookie: zero value and an
        expired ``Max - Age`` so any browser drops it immediately. -  #
        return self.cookie(name, "", path, - 1, domain, false, false, "")
    }

    func error_(self, code: int, msg: str = "") -> Response {
        #- Send an error response with a plain-text body. ``msg`` is
        the body
        if empty, the canonical status text is used.
        Named ``error_`` because ``error`` is a Lam alias for the
        built - in error type. -  #
        go! {
            s.Status = code
            body := msg
            if body == "" {
                body = http.StatusText(code)
            }
            s.Headers["Content-Type"] = "text/plain; charset=utf-8"
            s.Body = body
            s.Sent = true
            return s
        }
    }

    func signedCookie(self, name: str, value: str, secret: str, path: str = "/",
    maxAge: int = 0, domain: str = "", secure: bool = false,
    httpOnly: bool = true, sameSite: str = "Lax") -> Response {
        #- Sign ``value`` with HMAC-SHA256(secret) and stash as a
        ``Set - Cookie``. Read back with ``Request.signedCookie``.
        Tampering with either the value or the signature on the
        wire makes the read return ``""``.

        Defaults are tuned for session - cookie use:
        ``httpOnly = True`` and ``sameSite = "Lax"``. Pass
        ``secure = True`` when serving over HTTPS. -  #
        go! {
            sig := lamCookieSign(value, secret)
            signed := value + "." + sig
            s.Headers["Set-Cookie"] = lamServerAppendCookie(
                s.Headers["Set-Cookie"],
                lamServerBuildCookie(name, signed, path, maxAge, domain, secure, httpOnly, sameSite),
            )
            return s
        }
    }

    func streamFile(self, filePath: str, contentType: str = "") -> Response {
        #- Stream a file from disk to the client. Headers + status flush
        first
        the body is then copied with ``io.Copy`` so the entire
        file never sits in memory. Falls back to a 404 if the file
        is missing.

        Only works on the HTTP path(``listen`` / ``listenBackground``)
        on the ``inject()`` path the file is loaded into ``res.body``
        so tests can still assert against the bytes. -  #
        go! {
            f, err := os.Open(filePath)
            if err != nil {
                s.Status = 404
                s.Headers["Content-Type"] = "text/plain; charset=utf-8"
                s.Body = "404 not found"
                s.Sent = true
                return s
            }
            ct := contentType
            if ct == "" {
                ct = mime.TypeByExtension(filepath.Ext(filePath))
                if ct == "" {
                    ct = "application/octet-stream"
                }
            }
            s.Headers["Content-Type"] = ct
            s.StreamHandler = func(w http.ResponseWriter) {
                defer f.Close()
                io.Copy(w, f)
            }
            // Inject path: read into Body so .body remains useful.
            s.StreamFallback = func() string {
                defer f.Close()
                data, err := io.ReadAll(f)
                if err != nil {
                    return ""
                }
                return string(data)
            }
            s.Sent = true
            return s
        }
    }

    func sse(self, emitterFn: any) -> Response {
        #- Switch this response into Server-Sent Events mode. The
        dispatcher writes ``Content - Type: text / event - stream``,
        flushes the headers, and then invokes ``emitterFn`` with
        an ``SseEmitter`` until that function returns.

        ``emitterFn`` signature: ``func(emitter: SseEmitter)``. -  #
        self.headers["Content-Type"] = "text/event-stream"
        self.headers["Cache-Control"] = "no-cache"
        self.headers["Connection"] = "keep-alive"
        self.sseHandler = emitterFn
        self.sent = true
        return self
    }

    func push(self, target: str, contentType: str = "") -> Response {
        #- Queue an HTTP/2 server push for ``target`` (e.g.
        `` / static / app.js``). Pushes are best - effort: they only
        fire when the underlying ``http.ResponseWriter`` implements
        ``http.Pusher``(HTTP / 2 over TLS). Otherwise they're
        silently dropped — the client just falls back to fetching
        the resource normally on its own.

        ``contentType`` is optional
        when non - empty it's set on
        the synthetic push request's ``Content-Type`` header so the
        client treats the pushed bytes correctly. -  #
        go! {
            // Stash pushes in a slice on the response; the dispatcher
            // walks them after WriteHeader on HTTP/2 connections.
            entry := [2]string{target, contentType}
            s.Pushes = append(s.Pushes, entry)
            return s
        }
    }

    # ─── Decorators ────────────────────────────────────────
    func dec(self, name: str) -> any {
        #- Read a response-level decorator registered with
        ``Server.decorateReply`` / ``decorateResponse``. Returns
        ``None`` when missing. -  #
        go! {
            if decs, ok := s.Ctx["__lamRespDecorators"].(map[string]interface{}); ok {
                if v, has := decs[name]; has {
                    return v
                }
            }
            return nil
        }
    }

    func hasDec(self, name: str) -> bool {
        #- ``true`` iff a response-level decorator named ``name`` was
        registered. -  #
        go! {
            if decs, ok := s.Ctx["__lamRespDecorators"].(map[string]interface{}); ok {
                _, has := decs[name]
                return has
            }
            return false
        }
    }

    # ─── Fastify-parity sugar ──────────────────────────────
    func getHeader(self, name: str) -> str {
        #- Case-insensitive read of a header previously set on the
        response. Returns ``""`` when the header isn't set.
        Mirrors Fastify's ``reply.getHeader(name)`` — handlers
        often reach for this to observe what earlier hooks have
        written(eg a compression plugin checking whether the
        encoding is already locked). -  #
        needle: str = name.toLower()
        for key in self.headers {
            if key.toLower() == needle {
                return self.headers[key]
            }
        }
        return ""
    }

    func getHeaders(self) -> dict[str, str] {
        #- Snapshot of every header currently set on the response.
        Returns a * copy * so callers can mutate it without
        affecting the outgoing response. Mirrors Fastify's
        ``reply.getHeaders()``. -  #
        snapshot: dict[str, str] = {}
        for key in self.headers {
            snapshot[key] = self.headers[key]
        }
        return snapshot
    }

    func hasHeader(self, name: str) -> bool {
        #- ``true`` iff a header named ``name`` (case-insensitive)
        is set on the response. -  #
        needle: str = name.toLower()
        for key in self.headers {
            if key.toLower() == needle {
                return true
            }
        }
        return false
    }

    func removeHeader(self, name: str) -> Response {
        #- Delete a header from the response (case-insensitive).
        No - op if the header isn't set. Returns ``self`` so it
        chains with other builder - style calls. -  #
        needle: str = name.toLower()
        for key in self.headers {
            if key.toLower() == needle {
                del self.headers[key]
            }
        }
        return self
    }

    func hijack(self) -> Response {
        #- Mark the response as "hijacked" — after this the
        dispatcher will not write status, headers, or body, and
        will not invoke the rest of the hook ladder
        (``onSend`` / ``onResponse``). The handler is expected
        to take over ``self.rawWriter``(the raw
        ``http.ResponseWriter``) itself and manage the
        connection from there.

        Typical use: WebSocket upgrades, long - polling /
        streaming where the handler runs its own write loop,
        or a raw file - stream implementation. Mirrors Fastify's
        ``reply.hijack()``. -  #
        self.hijacked = true
        self.sent = true
        return self
    }

    func elapsedTime(self) -> int {
        #- Milliseconds since the dispatcher first saw the
        associated request. Captured at the top of
        ``lamServerDispatch`` on ``res.ctx["__lamReqStart"]``
        handlers, ``preSerialization`` hooks, and
        ``onSend`` / ``onResponse`` observers can all call this
        to attach a latency metric. Returns 0 when the
        dispatcher didn't run (eg a plugin constructed a
        synthetic response without going through inject). -  #
        go! {
            if v, ok := s.Ctx["__lamReqStart"].(time.Time); ok {
                return int(time.Since(v).Milliseconds())
            }
            return 0
        }
    }

    func getResponseTime(self) -> int {
        #- Alias for :py:meth:`elapsedTime`. Included so code ported
        from Fastify(``reply.getResponseTime()``) works
        unchanged. -  #
        return self.elapsedTime()
    }

    func setHeaders(self, values: dict[str, str]) -> Response {
        #- Set multiple response headers in one call. Existing headers
        with the same(case - sensitive) name are overwritten
        names not present in ``values`` are left untouched. Mirrors
        Fastify's ``reply.headers({...})`` — handy for sending a
        block of cache / security headers in a single shot. Returns
        ``self`` so it chains with the rest of the builder API.
        Named ``setHeaders``(not ``headers``) because the Response
        struct already has a ``headers`` field. -  #
        for key in values {
            self.headers[key] = values[key]
        }
        return self
    }

    func callNotFound(self) -> Response {
        #- Short-circuit the current handler and hand the response
        over to the server's ``notFoundHandler`` (or, if none is
        registered, a bare 404). Matches Fastify's
        ``reply.callNotFound()``. Flags the request so the
        dispatcher routes through the not - found pipeline on its
        next iteration — the calling handler should ``return``
        straight after this call. -  #
        self.ctx["__lamCallNotFound"] = true
        self.status = 404
        return self
    }

    func serialize(self, payload: any = None) -> str {
        #- Serialize ``payload`` (or the current body when ``payload``
        is ``None``) into the on - the - wire string, applying the
        matched route's response schema for the *current*
        ``self.status`` if one is registered. Mirrors Fastify's
        ``reply.serialize(payload)`` — useful for caching
        pre - serialised replies, piping the body into a
        different response, or asserting serializer behaviour
        from inside tests.

        Resolution order for the schema(same as the dispatcher's
        built - in serializer): exact status code("200") → status
        family("2xx") → ``"default"`` → no schema. When no
        schema matches, ``payload`` is passed through
        ``json.Marshal`` if it isn't already a string; a string
        is returned verbatim so text handlers round - trip
        cleanly.

        Does ** not ** mutate the response — call
        ``res.body = res.serialize(...)``(or ``res.json(...)``)
        if you want the serialised form on the wire. -  #
        out: str = ""
        go! {
            var body interface{}
            if payload == nil {
                body = s.Body
            } else {
                body = payload
            }

            route, _ := s.Ctx["__lamMatchedRoute"].(*lamRoute)
            if route != nil && route.opts != nil && len(route.opts.ResponseSchemas) > 0 {
                code := s.Status
                if code == 0 {
                    code = 200
                }
                keyExact := strconv.Itoa(code)
                keyFamily := fmt.Sprintf("%dxx", code/100)
                text, ok := route.opts.ResponseSchemas[keyExact]
                if !ok {
                    text, ok = route.opts.ResponseSchemas[keyFamily]
                }
                if !ok {
                    text, ok = route.opts.ResponseSchemas["default"]
                }
                if ok && text != "" {
                    // If “body“ is a string (e.g. the current
                    // “self.body“), try to decode it as JSON first
                    // so schema projection has a shot. Fall back to
                    // the raw string when decoding fails.
                    if bs, ok := body.(string); ok {
                        var decoded interface{}
                        if err := json.Unmarshal([]byte(bs), &decoded); err == nil {
                            body = decoded
                        }
                    }
                    var schemaDoc map[string]interface{}
                    _ = json.Unmarshal([]byte(text), &schemaDoc)
                    projected := lamProjectToSchema(body, schemaDoc)
                    if b, err := json.Marshal(projected); err == nil {
                        out = string(b)
                        return out
                    }
                }
            }

            // No schema (or schema projection failed): return a
            // string verbatim, everything else through the JSON
            // encoder.
            if bs, ok := body.(string); ok {
                out = bs
                return out
            }
            if b, err := json.Marshal(body); err == nil {
                out = string(b)
            }
        }
        return out
    }
}

class HttpError {
    #- Typed HTTP error: throw ``HttpError`` from a hook or handler to
    short - circuit with a structured ``application / problem + json``
    response. Caught by the dispatcher and routed through
    ``setErrorHandler`` / the ``onError`` chain.

    ::

    if not authed {
        panic(HttpError.unauthorized("login required"))
    }
    panic(HttpError(409, "duplicate", {"key": email}))

    ``data`` is serialised verbatim under the ``data`` key when
    present — useful for surfacing field - level validation errors. -  #

    func __init__(self, status: int, message: str = "", data: any = None) {
        self.status: int = status
        self.message: str = message
        self.data: any = data
    }

    func toString(self) -> str {
        return f"HttpError({self.status}): {self.message}"
    }

    static func badRequest(message: str = "Bad Request", data: any = None) -> HttpError {
        return HttpError(400, message, data)
    }

    static func unauthorized(message: str = "Unauthorized", data: any = None) -> HttpError {
        return HttpError(401, message, data)
    }

    static func forbidden(message: str = "Forbidden", data: any = None) -> HttpError {
        return HttpError(403, message, data)
    }

    static func notFound(message: str = "Not Found", data: any = None) -> HttpError {
        return HttpError(404, message, data)
    }

    static func conflict(message: str = "Conflict", data: any = None) -> HttpError {
        return HttpError(409, message, data)
    }

    static func unprocessable(message: str = "Unprocessable Entity", data: any = None) -> HttpError {
        return HttpError(422, message, data)
    }

    static func tooManyRequests(message: str = "Too Many Requests", data: any = None) -> HttpError {
        return HttpError(429, message, data)
    }

    static func internal(message: str = "Internal Server Error", data: any = None) -> HttpError {
        return HttpError(500, message, data)
    }

    static func badGateway(message: str = "Bad Gateway", data: any = None) -> HttpError {
        return HttpError(502, message, data)
    }

    static func serviceUnavailable(message: str = "Service Unavailable", data: any = None) -> HttpError {
        return HttpError(503, message, data)
    }
}

class SseEmitter {
    #- Wraps a ``http.ResponseWriter`` + ``http.Flusher`` and serialises
    events to the SSE wire format. Call ``send`` for unnamed data,
    ``sendEvent`` for named events, ``comment`` for keep - alive
    pings. ``done`` marks the emitter closed
    subsequent sends
    become no - ops.

    Construct one yourself only in tests
    the dispatcher creates one
    and passes it to your ``func(emitter: SseEmitter)`` SSE handler. -  #

    func __init__(self) {
        self.writer: any = None
        self.flusher: any = None
        self.closed: bool = false
    }

    func send(self, data: str) {
        #- Emit an unnamed event: ``data: <data>\n\n``. Multi-line
        values are split into multiple ``data: `` lines per the
        SSE spec. -  #
        if self.closed {
            return
        }
        go! {
            w, ok := s.Writer.(http.ResponseWriter)
            if !ok {
                return
            }
            for _, line := range strings.Split(data, "\n") {
                fmt.Fprintf(w, "data: %s\n", line)
            }
            fmt.Fprint(w, "\n")
            if fl, fok := s.Flusher.(http.Flusher); fok {
                fl.Flush()
            }
        }
    }

    func sendEvent(self, event: str, data: str) {
        #- Emit a named event: ``event: <event>\n data: <data>\n\n``. -#
        if self.closed {
            return
        }
        go! {
            w, ok := s.Writer.(http.ResponseWriter)
            if !ok {
                return
            }
            fmt.Fprintf(w, "event: %s\n", event)
            for _, line := range strings.Split(data, "\n") {
                fmt.Fprintf(w, "data: %s\n", line)
            }
            fmt.Fprint(w, "\n")
            if fl, fok := s.Flusher.(http.Flusher); fok {
                fl.Flush()
            }
        }
    }

    func comment(self, text: str) {
        #- SSE comment line. Useful as a heartbeat to keep proxies from
        idling out the connection. -  #
        if self.closed {
            return
        }
        go! {
            w, ok := s.Writer.(http.ResponseWriter)
            if !ok {
                return
            }
            fmt.Fprintf(w, ": %s\n\n", text)
            if fl, fok := s.Flusher.(http.Flusher); fok {
                fl.Flush()
            }
        }
    }

    func close(self) {
        #- Mark the emitter closed; further send calls become no-ops.
        The underlying connection is released when the SSE handler
        function returns. -  #
        self.closed = true
    }
}

class Server {
    #- HTTP server with Fastify-style hooks and a plug-in mechanism.

    Routes are registered via the method - shortcut helpers
    (``get`` / ``post`` / …) or the generic ``route(method, path, handler)``.
    Hooks run in this order around every request:

    onRequest → preHandler →[handler] → onResponse

    Any hook can short - circuit by populating ``res``(setting the
    body, status, or calling ``res.text()`` / ``res.json()``).
    Downstream hooks and the route handler won't run. The final
    ``onResponse`` ladder still executes so logging / metrics hooks
    observe everything.
    -  #

    func __init__(self) {
        self.routes: list[any] = []
        self.staticMounts: list[any] = []
        # Request-lifecycle hooks. Order: onRequest → preParsing →
        # preValidation → preHandler → handler → preSerialization
        # → onSend → onResponse. Mutating any hook list directly is
        # supported; the dispatcher reads the live slice on every
        # request so plugins can append at any time.
        self.onRequestHooks: list[any] = []
        self.preParsingHooks: list[any] = []
        self.preValidationHooks: list[any] = []
        self.preHandlerHooks: list[any] = []
        self.preSerializationHooks: list[any] = []
        self.onSendHooks: list[any] = []
        self.onResponseHooks: list[any] = []
        self.onErrorHooks: list[any] = []
        # App-lifecycle hooks. Fired once each at the corresponding
        # transition: onReady before the listener binds, onListen
        # after binding succeeds (the only hook where the bound
        # address is observable), onClose during graceful shutdown.
        self.onReadyHooks: list[any] = []
        self.onListenHooks: list[any] = []
        self.onCloseHooks: list[any] = []
        # Single user-supplied error handler. When set, takes
        # precedence over the ``onError`` hook chain — the chain is
        # still invoked first for observability (logging, metrics)
        # but the handler decides the actual response shape.
        # Signature: ``func(err: any, req: Request, res: Response)``.
        self.errorHandler: any = None
        self.notFoundHandler: any = None
        self.routePrefix: str = ""
        self.debug: bool = false
        # Maximum allowed request body size in bytes. ``0`` is the
        # historical default (no limit). When set, oversized POSTs
        # are rejected with ``413 Payload Too Large`` *before* any
        # hook runs. Apply on the entire chain or on a per-route
        # basis from a ``preHandler`` hook.
        self.bodyLimit: int = 0
        # ``trustProxyHeaders`` is empty by default — every request's
        # ``realIP()`` returns the direct peer's address. Call
        # ``trustProxy(...)`` once on startup if your traffic comes
        # through a known proxy chain.
        self.trustProxyHeaders: list[str] = []
        self.trustProxyHops: int = 1
        # Decorators à la Fastify: typed extension points on Server,
        # Request, Response. Stored as plain dicts; accessed via
        # ``Server.dec(name)`` / ``Request.dec(name)`` /
        # ``Response.dec(name)``. Decorators are visible to every
        # downstream hook + handler — perfect for stuffing shared
        # things like a database handle, JWT verifier, or Redis
        # pool.
        self.decorators: dict[str, any] = {}
        self.requestDecorators: dict[str, any] = {}
        self.replyDecorators: dict[str, any] = {}
        # Custom content-type parsers, keyed by media type
        # (lowercase, no parameters). Each value is a
        # ``func(req: Request) -> any`` that is invoked once during
        # the preParsing phase; the result is cached on
        # ``req.ctx["__parsed"]`` so handlers can read it via
        # ``req.parsedBody()`` without re-parsing.
        self.contentTypeParsers: dict[str, any] = {}
        # Shared JSON Schemas keyed by ``$id``. ``addSchema(...)``
        # registers them; per-route schemas reach into this map
        # through ``{"$ref": "<id>"}`` — resolution happens at the
        # first request that needs a given route schema and the
        # compiled output is cached forever (keyed by the fully
        # resolved schema text, so changing a shared schema
        # re-compiles only the routes that use it).
        self.sharedSchemas: dict[str, str] = {}
        # Optional ``func(where: str, errs: list[str], req: Request)
        # -> any`` replacing the default ``400 {statusCode, error,
        # message, validation}`` envelope Fastify emits. Return a
        # dict (serialised to JSON) or a str (used verbatim with
        # ``Content-Type: text/plain``).
        self.schemaErrorFormatter: any = None
        # ``onRequestAbort`` hooks fire when the HTTP client
        # disconnects before the handler completed (via
        # ``r.Context().Done()``). Signature:
        # ``func(req: Request)``. Useful for cancelling expensive
        # downstream work the handler kicked off (SSE streams,
        # slow-query timers, …).
        self.onRequestAbortHooks: list[any] = []
        # Per-request handler timeout in milliseconds. ``0`` disables
        # the timeout (the default — Fastify's behaviour too). When
        # set, the dispatcher wraps the handler chain in
        # ``context.WithTimeout`` and any ``r.Context().Done()`` —
        # observing handler can co-operatively bail out. If the
        # handler does not return before the deadline, the dispatcher
        # writes a 408 Request Timeout (or whatever an ``onTimeout``
        # hook produced) and abandons the goroutine. Override per
        # route via ``routeOpts({"timeoutMs": ...})``.
        self.requestTimeoutMs: int = 0
        # ``onTimeout`` hooks fire when the per-request handler
        # timeout (``requestTimeoutMs`` or per-route override) elapses
        # before the handler returns. Signature:
        # ``func(req: Request, res: Response)``. The hook may mutate
        # the response (status, headers, body); after every hook has
        # run, the dispatcher writes the response on the wire. Useful
        # for tagging the request with a tracing event, emitting a
        # custom timeout payload, or marking circuit breakers.
        self.onTimeoutHooks: list[any] = []
        # Plugin-shared state. Plugins that need long-lived state
        # (counters, gates, caches) can stash it under ``ctx`` rather
        # than maintaining a parallel registry. Keys with a ``__``
        # prefix are reserved for built-in plugins.
        self.ctx: dict[str, any] = {}
        # Trie router. Built lazily — calls to ``route()`` invalidate
        # it and the dispatcher rebuilds on first request after a
        # mutation. Implementation lives in the helper go! block; we
        # keep it as ``any`` here so the Lam type system doesn't have
        # to know about Go-only types.
        self.routeTrie: any = None
        # Populated *after* ``listen()`` successfully binds the
        # socket. Format: ``host:port`` (eg ``127.0.0.1:46531``).
        # Empty until the listener is up.
        self.boundAddr: str = ""
        self.rawSrv: any = None
        self.rawMu: any = None
        go! {
            s.RawMu = &sync.Mutex{}
        }
    }

    func trustProxy(self, headers: list[str] = ["X-Forwarded-For"], hops: int = 1) {
        #- Configure forwarded-IP header trust. After calling this:

        * ``Request.realIP()`` walks ``headers``(in order) and
        returns the rightmost value — i.e. the IP belonging to
        the trusted proxy that talked to us — adjusted by ``hops``
        (use ``hops = 2`` if there are two proxies between you and
        the original client and you want the * original * IP).
        * ``Request.realScheme()`` honours ``X - Forwarded - Proto``
        and RFC 7239 ``Forwarded: proto = ...``.
        * Plugins(e.g. ``rateLimit``) keyed on client IP follow
        the same logic automatically.

        ** Don't enable this unless you actually have a proxy.** A
        public - facing server that trusts ``X - Forwarded - For`` lets
        any client spoof any IP. -  #
        self.trustProxyHeaders = headers
        if hops < 1 {
            hops = 1
        }
        self.trustProxyHops = hops
    }

    # ─── Route registration ────────────────────────────────
    func route(self, method: str, path: str, handler: any, schema: str | json | None = None, schemaFormat: str = "json") {
        go! {
            full := s.RoutePrefix + path
            var r lamRoute
            if schema == nil {
                r = lamCompileRoute(method, full, handler)
            } else {
                if schemaFormat != "json" && schemaFormat != "yaml" && schemaFormat != "xml" {
                    panic("SchemaFormatError: unsupported schema format " + schemaFormat)
                }
                opts := lamCoerceRouteOpts(map[string]interface{}{
                    "schema":       map[string]interface{}{"body": schema},
                    "schemaFormat": schemaFormat,
                })
                if schemaFormat == "json" {
                    if _, failure := lamSchemaCompileText(opts.BodySchema); failure != nil {
                        panic(failure.kind + ": " + failure.message)
                    }
                }
                r = lamCompileRouteWithOpts(method, full, handler, opts)
            }
            s.Routes = append(s.Routes, r)
            // Lazily allocate the trie on first registration.
            t, ok := s.RouteTrie.(*lamRouteTrie)
            if !ok || t == nil {
                t = newLamRouteTrie()
                s.RouteTrie = t
            }
            lamTrieInsert(t, r)
        }
    }

    func routeOpts(self, method: str, path: str, handler: any, opts: any) {
        #- Register a route with per-route options. ``opts`` is a
        ``dict[str, any]`` accepting these keys:

        * ``bodyLimit``(int) — overrides ``Server.bodyLimit`` for
        this route only. ``413`` if exceeded.
        * ``timeoutMs`` / ``timeout``(int) — per - request handler
        timeout in milliseconds, overriding
        ``Server.setRequestTimeout``. ``0`` inherits.
        * ``streamBody`` / ``stream``(bool) — when true, skip
        the buffered body read
        ``req.body`` stays empty and
        handlers pull chunks from ``req.bodyReader()``. Use
        for large uploads or chunked ingest.
        * ``preParsing`` / ``preValidation`` / ``preHandler`` /
        ``preSerialization`` / ``onSend`` / ``onResponse`` /
        ``onError``(func) — route - scoped lifecycle hooks. Run
        *after * their global counterparts.
        * ``schema``(dict) — JSON Schema for body / querystring
        / params / headers / response. Each leaf may be a
        JSON - Schema string or a Lam dict
        the dispatcher
        compiles them lazily.
        * ``summary`` / ``description`` / ``operationId``(str)
        — OpenAPI metadata.
        * ``tags``(list[str]) — categorisation tags.
        * ``deprecated``(bool) — marks the route deprecated in
        ``listRoutes`` and the OpenAPI generator.
        * ``hidden``(bool) — hides the route from ``listRoutes``
        and OpenAPI output.
        * ``consumes`` / ``produces``(list[str]) — OpenAPI media
        types accepted / returned.

        Anything not recognised lands in ``opts.meta`` and is
        echoed back by ``listRoutes``. -  #
        go! {
            full := s.RoutePrefix + path
            optsTyped := lamCoerceRouteOpts(opts)
            r := lamCompileRouteWithOpts(method, full, handler, optsTyped)
            s.Routes = append(s.Routes, r)
            t, ok := s.RouteTrie.(*lamRouteTrie)
            if !ok || t == nil {
                t = newLamRouteTrie()
                s.RouteTrie = t
            }
            lamTrieInsert(t, r)
        }
    }

    func get(self, path: str, handler: any, schema: str | json | None = None, schemaFormat: str = "json") {
        self.route("GET", path, handler, schema, schemaFormat)
    }

    func post(self, path: str, handler: any, schema: str | json | None = None, schemaFormat: str = "json") {
        self.route("POST", path, handler, schema, schemaFormat)
    }

    func put(self, path: str, handler: any, schema: str | json | None = None, schemaFormat: str = "json") {
        self.route("PUT", path, handler, schema, schemaFormat)
    }

    func del(self, path: str, handler: any, schema: str | json | None = None, schemaFormat: str = "json") {
        #- Named ``del`` because ``delete`` is a Go builtin. -#
        self.route("DELETE", path, handler, schema, schemaFormat)
    }

    func patch(self, path: str, handler: any, schema: str | json | None = None, schemaFormat: str = "json") {
        self.route("PATCH", path, handler, schema, schemaFormat)
    }

    func head(self, path: str, handler: any, schema: str | json | None = None, schemaFormat: str = "json") {
        self.route("HEAD", path, handler, schema, schemaFormat)
    }

    func options(self, path: str, handler: any, schema: str | json | None = None, schemaFormat: str = "json") {
        self.route("OPTIONS", path, handler, schema, schemaFormat)
    }

    func all(self, path: str, handler: any, schema: str | json | None = None, schemaFormat: str = "json") {
        #- Register the same handler for every common HTTP verb. Useful
        for catch - all health - check / fallback endpoints. -  #
        self.route("GET", path, handler, schema, schemaFormat)
        self.route("POST", path, handler, schema, schemaFormat)
        self.route("PUT", path, handler, schema, schemaFormat)
        self.route("DELETE", path, handler, schema, schemaFormat)
        self.route("PATCH", path, handler, schema, schemaFormat)
        self.route("HEAD", path, handler, schema, schemaFormat)
        self.route("OPTIONS", path, handler, schema, schemaFormat)
    }

    func getOpts(self, path: str, handler: any, opts: any) {
        self.routeOpts("GET", path, handler, opts)
    }

    func postOpts(self, path: str, handler: any, opts: any) {
        self.routeOpts("POST", path, handler, opts)
    }

    func putOpts(self, path: str, handler: any, opts: any) {
        self.routeOpts("PUT", path, handler, opts)
    }

    func delOpts(self, path: str, handler: any, opts: any) {
        self.routeOpts("DELETE", path, handler, opts)
    }

    func patchOpts(self, path: str, handler: any, opts: any) {
        self.routeOpts("PATCH", path, handler, opts)
    }

    func headOpts(self, path: str, handler: any, opts: any) {
        self.routeOpts("HEAD", path, handler, opts)
    }

    func optionsOpts(self, path: str, handler: any, opts: any) {
        self.routeOpts("OPTIONS", path, handler, opts)
    }

    func notFound(self, handler: any) {
        #- Register a handler for paths that match no route.
        Signature is the same as any other handler. -  #
        self.notFoundHandler = handler
    }

    # ─── Request-lifecycle hooks ───────────────────────────
    # Fastify's full ladder, fired in this order for every request:
    #   onRequest      → first touch, before body parsing
    #   preParsing     → body still raw (bytes in req.body); good
    #                    spot for custom content-type parsers
    #   preValidation  → after parsing, before schema validation
    #   preHandler     → after validation, immediately before the
    #                    route handler runs
    #   (handler)
    #   preSerialization → before the response body is stringified
    #   onSend         → last hook before the bytes hit the wire;
    #                    headers/body are final here
    #   onResponse     → observational; body/status are locked in
    #   onError        → only fires on panic in any of the above
    func onRequest(self, hook: any) {
        #- Hook signature: ``func(req: Request, res: Response)``. -#
        self.onRequestHooks.append(hook)
    }

    func preParsing(self, hook: any) {
        #- Runs before the dispatcher invokes any content-type
        parser. Useful for rewriting bodies(eg Brotli - decoded
        uploads) or short - circuiting on inspected headers. -  #
        self.preParsingHooks.append(hook)
    }

    func preValidation(self, hook: any) {
        #- Runs after parsing, before schema validation kicks in.
        Mutating ``req.body`` / ``req.query`` / ``req.params`` /
        ``req.headers`` here is honoured by the validator. -  #
        self.preValidationHooks.append(hook)
    }

    func preHandler(self, hook: any) {
        self.preHandlerHooks.append(hook)
    }

    func preSerialization(self, hook: any) {
        #- Fires after the handler returns, before the response body
        is serialised(``res.body``). Mutating the body here is
        honoured by the serializer. -  #
        self.preSerializationHooks.append(hook)
    }

    func onSend(self, hook: any) {
        #- Last hook before the response leaves the server. Headers,
        status and body are all final — mutate with care. -  #
        self.onSendHooks.append(hook)
    }

    func onResponse(self, hook: any) {
        self.onResponseHooks.append(hook)
    }

    func onError(self, hook: any) {
        #- Register an error hook. Hook signature is
        ``func(req: Request, res: Response, errMsg: any)``.
        Every registered hook is invoked when a handler / hook
        panics
        mutate ``res`` to control the response. If no
        hook calls ``res.text / .json / .send``, a generic 500 is
        emitted as a fallback. -  #
        self.onErrorHooks.append(hook)
    }

    func setErrorHandler(self, handler: any) {
        #- Install a *single* central error handler, Fastify-style.
        Signature: ``func(err: any, req: Request, res: Response)``.
        The handler owns the response shape when a panic occurs
        ``onError`` hooks still fire first(for logs / metrics) but
        the handler decides the wire output. Only one handler may
        be active — calling this replaces any prior handler. -  #
        self.errorHandler = handler
    }

    func setNotFoundHandler(self, handler: any) {
        #- Fastify-compatible alias for ``notFound``. -#
        self.notFoundHandler = handler
    }

    # ─── App-lifecycle hooks ───────────────────────────────
    # Fire once per transition, not per request. Perfect for
    # acquiring / releasing resources (DB pools, Redis, external
    # services). Panics inside these hooks are swallowed with a log
    # line rather than killing the process.
    func onReady(self, hook: any) {
        #- Runs synchronously just before ``listen()`` binds. -#
        self.onReadyHooks.append(hook)
    }

    func onListen(self, hook: any) {
        #- Runs *after* ``listen()`` successfully binds the socket.
        The only callback point where ``srv.boundAddr()`` is
        guaranteed populated(for ``: 0`` ephemeral ports). -  #
        self.onListenHooks.append(hook)
    }

    func onClose(self, hook: any) {
        #- Runs during ``close()`` / ``shutdown()``, in reverse
        registration order(teardown is the mirror of setup). -  #
        self.onCloseHooks.append(hook)
    }

    # ─── Decorators ────────────────────────────────────────
    # Fastify's decorator system: attach named values to Server,
    # Request, or Reply without monkey-patching the classes. Every
    # downstream handler can read them back with ``.dec(name)``.
    # Decorators registered after ``listen()`` starts are honoured
    # for subsequent requests (we read them live during dispatch).
    func decorate(self, name: str, value: any) {
        #- Attach ``value`` to the server; read back with
        ``srv.dec(name)``. Common uses: database handles, JWT
        verifiers, feature - flag resolvers, shared caches. -  #
        self.decorators[name] = value
    }

    func decorateRequest(self, name: str, value: any) {
        #- Attach ``value`` to every incoming request. Handlers read
        with ``req.dec(name)``. Typical: request - ID factories,
        locale resolvers, per - request audit logger. -  #
        self.requestDecorators[name] = value
    }

    func decorateReply(self, name: str, value: any) {
        #- Fastify-named alias for ``decorateResponse``. -#
        self.replyDecorators[name] = value
    }

    func decorateResponse(self, name: str, value: any) {
        #- Attach ``value`` to every outgoing response; handlers read
        with ``res.dec(name)``. Typical: reply helpers, redirect
        builders, structured - error serializers. -  #
        self.replyDecorators[name] = value
    }

    func dec(self, name: str) -> any {
        #- Read back a server-level decorator. Returns ``None`` if
        the name was never registered. -  #
        if name in self.decorators {
            return self.decorators[name]
        }
        return None
    }

    func hasDecorator(self, name: str) -> bool {
        #- ``true`` iff ``decorate(name, …)`` was ever called. -#
        return name in self.decorators
    }

    # ─── Content-type parsers ──────────────────────────────
    func addContentTypeParser(self, mediaType: str, parser: any) {
        #- Register a parser for ``mediaType``. Signature:
        ``func(req: Request) -> any``. The result is cached on
        ``req.ctx["__parsed"]`` and exposed via
        ``req.parsedBody()``. ``mediaType`` is case - insensitive
        and may omit parameters(eg ``application / json`` matches
        ``application / json
        charset = utf - 8``). Built - ins for
        ``application / json``, ``text / plain`` and
        ``application / x - www - form - urlencoded`` are registered
        implicitly
        registering an override wins. -  #
        go! {
            key := strings.ToLower(strings.TrimSpace(mediaType))
            // Strip parameters: “application/json; charset=utf-8“
            // and “application/json“ should hash to the same key.
            if i := strings.IndexByte(key, ';'); i >= 0 {
                key = strings.TrimSpace(key[:i])
            }
            s.ContentTypeParsers[key] = parser
        }
    }

    # ─── Shared JSON Schemas ───────────────────────────────
    func addSchema(self, schema: any) {
        #- Register a shared JSON Schema so route schemas can
        reference it by ``$ref``. ``schema`` may be a dict with
        a top - level ``$id`` key, a ``(id, schema)`` 2 - tuple, or
        a raw JSON string whose first object carries the
        ``$id``. Matching Fastify's ``fastify.addSchema(...)``:

        ::

        srv.addSchema( {
            "$id": "timestamp",
            "type": "string",
            "format": "date-time",
        })

        srv.postOpts("/events", createEvent, {
            "body": {
                "type": "object",
                "properties": {
                    "createdAt": {"$ref": "timestamp"},
                },
            },
        })

        Re - registering the same ``$id`` replaces the previous
        schema
        this is how tests typically reset between
        cases. An empty / missing ``$id`` is a no - op so
        handlers can pass through data defensively. -  #
        go! {
            text := ""
            id := ""
            switch v := schema.(type) {
            case string:
                text = v
                var probe map[string]interface{}
                if err := json.Unmarshal([]byte(v), &probe); err == nil {
                    if raw, ok := probe["$id"].(string); ok {
                        id = raw
                    }
                }
            case map[string]interface{}:
                if raw, ok := v["$id"].(string); ok {
                    id = raw
                }
                if b, err := json.Marshal(v); err == nil {
                    text = string(b)
                }
            }
            if id == "" || text == "" {
                return
            }
            s.SharedSchemas[id] = text
        }
    }

    func removeSchema(self, id: str) {
        #- Forget a previously-registered shared schema. Routes
        that still reference it will fail compile on the next
        request(and surface a 400 via the regular validation
        path). -  #
        if id in self.sharedSchemas {
            del self.sharedSchemas[id]
        }
    }

    func setSchemaErrorFormatter(self, fn: any) {
        #- Install a custom formatter for schema-validation
        failures. Signature:

        ``func(where: str, errs: list[str], req: Request) -> any``

        where ``where`` is one of ``"body"``, ``"querystring"``,
        ``"params"``, ``"headers"``(matching the location that
        failed), ``errs`` is the list of gojsonschema error
        strings, and ``req`` is the incoming request.

        The return value shapes the 400 response body:
        * a ``dict[str, any]`` → serialised as JSON(mirrors
        Fastify's default structure)
        * a ``str`` → sent verbatim with ``Content - Type:
        text / plain``
        * anything else → treated as opaque
        ``fmt.Sprintf``
        renders it

        Pass ``None`` to restore the built - in envelope. -  #
        self.schemaErrorFormatter = fn
    }

    func onRequestAbort(self, hook: any) {
        #- Register a hook fired when the HTTP client disconnects
        before the handler finished writing. Signature:
        ``func(req: Request)``. Multiple hooks run in
        registration order. Panics inside a hook are swallowed
        with a log line so one misbehaving observer can't take
        the listener down.

        The hook runs on a * separate goroutine * from the
        handler — it can race with handler completion. Use it
        to cancel context / close DB sessions / stop background
        goroutines keyed off the request, not to mutate the
        response. The inject path never triggers this hook
        (there's no network peer to drop the connection). -#
        self.onRequestAbortHooks.append(hook)
    }

    func setRequestTimeout(self, timeoutMs: int) {
        #- Set the *default* per-request handler timeout, in
        milliseconds. Pass ``0`` to disable. Per - route override:
        ``srv.routeOpts(method, path, handler, {"timeoutMs": ms})``.

        When the deadline elapses before the handler returns:

        1. Every ``onTimeout`` hook runs in registration order.
        2. If the response is still un - sent, the dispatcher
        writes a ``408 Request Timeout``(or whatever the
        hooks produced) with an ``application / json`` body
        `` {
            "statusCode": 408, "error": "Request Timeout",
            "message": "..."
        }
        `` — same envelope as ``HttpError``.
        3. The handler goroutine is * not * killed(Go can't
        force - cancel a goroutine), but its eventual return
        is ignored. Co - operative handlers that observe
        ``req.rawHttp.Context().Done()`` exit cleanly. -  #
        if timeoutMs < 0 {
            timeoutMs = 0
        }
        self.requestTimeoutMs = timeoutMs
    }

    func onTimeout(self, hook: any) {
        #- Register a hook fired when a per-request timeout elapses.
        Signature: ``func(req: Request, res: Response)``. Hooks
        run sequentially on a watcher goroutine and may mutate
        the response(status, headers, body) before it goes on
        the wire. Panics inside a hook are recovered. -  #
        self.onTimeoutHooks.append(hook)
    }

    # ─── Static files ──────────────────────────────────────
    func static_(self, urlPrefix: str, dir: str) {
        #- Serve files from ``dir`` under ``urlPrefix``. Trailing
        slashes are normalised. Path - traversal attempts(``.. / ``)
        return 403. ``dir`` may be relative
        it is evaluated
        against the working directory of the server process. -  #
        go! {
            mount := [2]string{urlPrefix, dir}
            s.StaticMounts = append(s.StaticMounts, mount)
        }
    }

    # ─── Versioned routing ────────────────────────────────
    func versionedRoute(self, method: str, path: str, handlers: dict[str, any], fallback: str = "", header: str = "Accept-Version") {
        #- Register a single route that dispatches to one of several
        handlers based on a request header's value. ``handlers``
        maps a version label("v1", "v2", …) to a handler
        ``func(req: Request, res: Response)``.

        Resolution:
        1. Read ``header`` from the request(case - insensitive).
        2. If the header's value matches a key in ``handlers``,
        use that handler.
        3. Else if ``fallback`` is set and matches a key, use
        that handler.
        4. Else reply with 406 Not Acceptable.

        The matched version is stashed on ``req.ctx["__lamApiVersion"]``
        so downstream hooks(logging, metrics) can tag it.

        Pairs naturally with path - based versioning via
        ``srv.register(pluginV1, "/v1", true)`` — use whichever
        style your clients expect
        this helper covers the
        header style. -  #
        dispatcher: any = None
        go! {
            dispatcher = func(req *Request, res *Response) {
                want := ""
                for k, v := range req.Headers {
                    if strings.EqualFold(k, header) && v != "" {
                        want = v
                        break
                    }
                }
                chosen, ok := handlers[want]
                if !ok && fallback != "" {
                    chosen, ok = handlers[fallback]
                    if ok {
                        want = fallback
                    }
                }
                if !ok {
                    res.Status = 406
                    res.Headers["Content-Type"] = "text/plain; charset=utf-8"
                    keys := make([]string, 0, len(handlers))
                    for k := range handlers {
                        keys = append(keys, k)
                    }
                    slices.Sort(keys)
                    res.Body = fmt.Sprintf(
                        "406 Not Acceptable: unknown %s %q (known: %s)",
                        header, want, strings.Join(keys, ", "),
                    )
                    res.Sent = true
                    return
                }
                req.Ctx.Set("__lamApiVersion", want)
                if fn, ok := chosen.(func(*Request, *Response)); ok {
                    fn(req, res)
                }
            }
        }
        self.route(method, path, dispatcher)
    }

    # ─── Plugin registration ───────────────────────────────
    func register(self, plugin: any, prefix: str = "", encapsulate: bool = false) {
        #- Run a plugin synchronously. A plugin is
        ``func(srv: Server) -> None`` — it configures the server
        (adding routes, hooks, helpers) and returns.

        If ``prefix`` is non - empty, every route the plugin
        registers is mounted under that prefix
        nested
        ``register(..., prefix = ...)`` calls compose.

        If ``encapsulate`` is ``true``, request - lifecycle hooks
        added inside the plugin become * scoped * to the plugin's
        routes only — sibling plugins don't observe them. This
        mirrors Fastify's encapsulation contract. Decorators and
        ``onReady`` / ``onListen`` / ``onClose`` hooks remain
        global(Fastify's behaviour matches). -#
        go! {
            oldPrefix := s.RoutePrefix
            s.RoutePrefix = oldPrefix + prefix
            defer func() { s.RoutePrefix = oldPrefix }()

            if !encapsulate {
                if fn, ok := plugin.(func(*Server)); ok {
                    fn(s)
                } else {
                    panic("Server.register: plugin must be func(Server) -> None")
                }
                return
            }

            // ── Encapsulated path ──────────────────────────
            // Snapshot every request-lifecycle hook list and the
            // existing route count. After the plugin returns,
            // hooks added during its run become route-level
            // preHandler / onResponse / … on the new routes; the
            // global lists are restored, so sibling plugins
            // don't observe them.
            type listSlot struct {
                ptr    *[]interface{}
                length int
                attach func(opts *lamRouteOpts, hook interface{})
            }

            slots := []listSlot{
                {&s.OnRequestHooks, len(s.OnRequestHooks), func(o *lamRouteOpts, h interface{}) {
                    o.PreHandler = lamRouteOptsChain(o.PreHandler, h)
                }},
                {&s.PreParsingHooks, len(s.PreParsingHooks), func(o *lamRouteOpts, h interface{}) {
                    o.PreParsing = lamRouteOptsChain(o.PreParsing, h)
                }},
                {&s.PreValidationHooks, len(s.PreValidationHooks), func(o *lamRouteOpts, h interface{}) {
                    o.PreValidation = lamRouteOptsChain(o.PreValidation, h)
                }},
                {&s.PreHandlerHooks, len(s.PreHandlerHooks), func(o *lamRouteOpts, h interface{}) {
                    o.PreHandler = lamRouteOptsChain(o.PreHandler, h)
                }},
                {&s.PreSerializationHooks, len(s.PreSerializationHooks), func(o *lamRouteOpts, h interface{}) {
                    o.PreSerialization = lamRouteOptsChain(o.PreSerialization, h)
                }},
                {&s.OnSendHooks, len(s.OnSendHooks), func(o *lamRouteOpts, h interface{}) {
                    o.OnSend = lamRouteOptsChain(o.OnSend, h)
                }},
                {&s.OnResponseHooks, len(s.OnResponseHooks), func(o *lamRouteOpts, h interface{}) {
                    o.OnResponse = lamRouteOptsChain(o.OnResponse, h)
                }},
            }
            routesBefore := len(s.Routes)

            if fn, ok := plugin.(func(*Server)); ok {
                fn(s)
            } else {
                panic("Server.register: plugin must be func(Server) -> None")
            }

            // For each new hook that was added, attach it to every
            // route the plugin registered, then truncate the
            // global slice back to the snapshot.
            for _, slot := range slots {
                added := (*slot.ptr)[slot.length:]
                if len(added) == 0 {
                    continue
                }
                for ri := routesBefore; ri < len(s.Routes); ri++ {
                    route, ok := s.Routes[ri].(lamRoute)
                    if !ok {
                        continue
                    }
                    if route.opts == nil {
                        route.opts = &lamRouteOpts{Meta: map[string]interface{}{}}
                    }
                    for _, h := range added {
                        slot.attach(route.opts, h)
                    }
                    s.Routes[ri] = route
                }
                *slot.ptr = (*slot.ptr)[:slot.length]
            }

            // Rebuild the trie since we mutated route opts in place.
            t := newLamRouteTrie()
            for _, rr := range s.Routes {
                if route, ok := rr.(lamRoute); ok {
                    lamTrieInsert(t, route)
                }
            }
            s.RouteTrie = t
        }
    }

    func useCors(self, origin: str = "*", methods: str = "GET, POST, PUT, DELETE, PATCH, OPTIONS", headers: str = "Content-Type, Authorization") {
        #- Enable CORS: inject ``Access-Control-Allow-*`` headers on
        every response and short - circuit ``OPTIONS`` preflight
        requests with a 204. Call this once during setup. -  #
        go! {
            // Headers on every response.
            s.OnResponseHooks = append(s.OnResponseHooks, func(req *Request, res *Response) {
                if res.Headers == nil {
                    res.Headers = map[string]string{}
                }
                res.Headers["Access-Control-Allow-Origin"] = origin
                res.Headers["Access-Control-Allow-Methods"] = methods
                res.Headers["Access-Control-Allow-Headers"] = headers
            })
            // Preflight short-circuit (prepended so it runs first).
            preflight := func(req *Request, res *Response) {
                if req.Method == "OPTIONS" {
                    res.Status = 204
                    res.Sent = true
                }
            }
            s.OnRequestHooks = append([]interface{}{preflight}, s.OnRequestHooks...)
        }
    }

    func useSecurityHeaders(self, opts: dict[str, any] = {}) {
        #- Attach Helmet-style security headers to every response.
        The defaults match what ``helmet`` ships in the Node
        ecosystem: strict transport security, no MIME sniff, a
        frame - ancestors lock, referrer minimisation, a
        conservative CSP, and cross - origin isolation. All values
        are overridable via ``opts``
        pass an empty string to
        disable a specific header:

        srv.useSecurityHeaders( {
            "contentSecurityPolicy": "default-src 'self'; img-src *",
            "hstsMaxAge": 0,  # disable HSTS
            "xFrameOptions": "SAMEORIGIN",
            "referrerPolicy": "strict-origin",
        })

        Recognised keys: ``contentSecurityPolicy``(str),
        ``hstsMaxAge``(int, seconds
        0 disables),
        ``hstsIncludeSubDomains``(bool),
        ``xContentTypeOptions``(str, default ``"nosniff"``),
        ``xFrameOptions``(str, default ``"DENY"``),
        ``referrerPolicy``(str, default ``"no-referrer"``),
        ``crossOriginOpenerPolicy``(str, default ``"same-origin"``),
        ``crossOriginResourcePolicy``(str, default ``"same-origin"``),
        ``xDnsPrefetchControl``(str, default ``"off"``),
        ``xDownloadOptions``(str, default ``"noopen"``),
        ``xPermittedCrossDomainPolicies``(str, default ``"none"``),
        ``originAgentCluster``(str, default ``"?1"``),
        ``permissionsPolicy``(str, empty by default — set to
        enable feature - policy opt - outs). -  #
        go! {
            // Defaults.
            csp := "default-src 'self'"
            hstsMax := 15552000 // 180 days
            hstsSub := true
            xCTO := "nosniff"
            xFO := "DENY"
            ref := "no-referrer"
            coop := "same-origin"
            corp := "same-origin"
            dnsP := "off"
            dlo := "noopen"
            xpc := "none"
            oac := "?1"
            pp := ""

            override := func(k string, dst *string) {
                if v, ok := opts[k]; ok {
                    if sv, sok := v.(string); sok {
                        *dst = sv
                    }
                }
            }
            override("contentSecurityPolicy", &csp)
            override("xContentTypeOptions", &xCTO)
            override("xFrameOptions", &xFO)
            override("referrerPolicy", &ref)
            override("crossOriginOpenerPolicy", &coop)
            override("crossOriginResourcePolicy", &corp)
            override("xDnsPrefetchControl", &dnsP)
            override("xDownloadOptions", &dlo)
            override("xPermittedCrossDomainPolicies", &xpc)
            override("originAgentCluster", &oac)
            override("permissionsPolicy", &pp)
            if v, ok := opts["hstsMaxAge"]; ok {
                if n, nok := v.(int); nok {
                    hstsMax = n
                }
                if n, nok := v.(int64); nok {
                    hstsMax = int(n)
                }
            }
            if v, ok := opts["hstsIncludeSubDomains"]; ok {
                if b, bok := v.(bool); bok {
                    hstsSub = b
                }
            }

            s.OnResponseHooks = append(s.OnResponseHooks, func(req *Request, res *Response) {
                if res.Headers == nil {
                    res.Headers = map[string]string{}
                }
                set := func(name, value string) {
                    if value == "" {
                        return
                    }
                    // Don't stomp on headers the handler already set
                    // — useful for routes that need a looser CSP.
                    for k := range res.Headers {
                        if strings.EqualFold(k, name) {
                            return
                        }
                    }
                    res.Headers[name] = value
                }
                set("Content-Security-Policy", csp)
                if hstsMax > 0 {
                    v := fmt.Sprintf("max-age=%d", hstsMax)
                    if hstsSub {
                        v += "; includeSubDomains"
                    }
                    set("Strict-Transport-Security", v)
                }
                set("X-Content-Type-Options", xCTO)
                set("X-Frame-Options", xFO)
                set("Referrer-Policy", ref)
                set("Cross-Origin-Opener-Policy", coop)
                set("Cross-Origin-Resource-Policy", corp)
                set("X-DNS-Prefetch-Control", dnsP)
                set("X-Download-Options", dlo)
                set("X-Permitted-Cross-Domain-Policies", xpc)
                set("Origin-Agent-Cluster", oac)
                if pp != "" {
                    set("Permissions-Policy", pp)
                }
            })
        }
    }

    func hasRoute(self, method: str, path: str) -> bool {
        #- ``true`` iff a route with the exact ``method`` +
        ``path`` pattern is currently registered. Useful in
        plugin setup to detect conflicts before piling on. The
        path is matched * literally * (`` / users /: id`` won't match
        `` / users / 42``) — use ``inject(...)`` for wildcard
        checks. -  #
        go! {
            want := strings.ToUpper(method)
            for _, rr := range s.Routes {
                r, ok := rr.(lamRoute)
                if !ok {
                    continue
                }
                if r.method != want {
                    continue
                }
                pattern := "/" + strings.Join(r.segments, "/")
                if len(r.segments) == 1 && r.segments[0] == "" {
                    pattern = "/"
                }
                if pattern == path {
                    return true
                }
            }
            return false
        }
    }

    # ─── Runtime ───────────────────────────────────────────
    func listen(self, port: int) {
        #- Start the server on ``:port`` and block until ``close()``.
        Fires ``onReady`` synchronously before bind, ``onListen``
        after bind succeeds, and ``onClose`` during shutdown. -  #
        go! {
            srvLocal := s
            mux := http.NewServeMux()
            mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
                lamServerHandle(srvLocal, w, r)
            })
            // “onReady“ is the right place to acquire resources
            // that must be live before any request lands.
            lamRunLifecycleHooks(s.OnReadyHooks, s)
            ln, err := net.Listen("tcp", fmt.Sprintf(":%d", port))
            if err != nil {
                panic("Server.listen: " + err.Error())
            }
            s.BoundAddr = ln.Addr().String()
            httpSrv := &http.Server{Handler: mux}
            s.RawSrv = httpSrv
            // Surface the bound address to plugins (loggers, service
            // registrars, …) before we start accepting traffic.
            lamRunLifecycleHooks(s.OnListenHooks, s)
            httpSrv.Serve(ln)
        }
    }

    func listenBackground(self, port: int) {
        #- Same as ``listen`` but returns immediately; the server runs
        in a goroutine. Useful for tests. -  #
        go! {
            srvLocal := s
            mux := http.NewServeMux()
            mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
                lamServerHandle(srvLocal, w, r)
            })
            lamRunLifecycleHooks(s.OnReadyHooks, s)
            ln, err := net.Listen("tcp", fmt.Sprintf(":%d", port))
            if err != nil {
                panic("Server.listenBackground: " + err.Error())
            }
            s.BoundAddr = ln.Addr().String()
            httpSrv := &http.Server{Handler: mux}
            s.RawSrv = httpSrv
            lamRunLifecycleHooks(s.OnListenHooks, s)
            go func() { httpSrv.Serve(ln) }()
            // Let the goroutine schedule before we return.
            time.Sleep(20 * time.Millisecond)
        }
    }

    func close(self) {
        #- Shut the server down immediately, severing in-flight
        connections. Use ``shutdown(timeoutMs)`` for graceful
        drain. ``onClose`` hooks fire in reverse registration
        order. -  #
        go! {
            s.RawMu.(*sync.Mutex).Lock()
            defer s.RawMu.(*sync.Mutex).Unlock()
            if s.RawSrv != nil {
                httpSrv := s.RawSrv.(*http.Server)
                httpSrv.Close()
                s.RawSrv = nil
            }
            lamRunLifecycleHooksReverse(s.OnCloseHooks, s)
            s.BoundAddr = ""
        }
    }

    func shutdown(self, timeoutMs: int = 5000) {
        #- Graceful shutdown: stop accepting new connections and wait
        up to ``timeoutMs`` for in - flight requests to finish. If the
        timeout elapses, surviving connections are force - closed.
        ``onClose`` hooks fire in reverse registration order * after *
        the listener stops accepting new requests. -  #
        go! {
            s.RawMu.(*sync.Mutex).Lock()
            defer s.RawMu.(*sync.Mutex).Unlock()
            if s.RawSrv != nil {
                httpSrv := s.RawSrv.(*http.Server)
                ctx, cancel := context.WithTimeout(
                    context.Background(),
                    time.Duration(timeoutMs)*time.Millisecond,
                )
                defer cancel()
                if err := httpSrv.Shutdown(ctx); err != nil {
                    httpSrv.Close()
                }
                s.RawSrv = nil
            }
            lamRunLifecycleHooksReverse(s.OnCloseHooks, s)
            s.BoundAddr = ""
        }
    }

    func listenTLS(self, port: int, certFile: str, keyFile: str) {
        #- Same as ``listen``, but serves HTTPS using the cert/key pair.
        Blocks until ``close()`` / ``shutdown()``. -  #
        go! {
            srvLocal := s
            mux := http.NewServeMux()
            mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
                lamServerHandle(srvLocal, w, r)
            })
            lamRunLifecycleHooks(s.OnReadyHooks, s)
            ln, err := net.Listen("tcp", fmt.Sprintf(":%d", port))
            if err != nil {
                panic("Server.listenTLS: " + err.Error())
            }
            s.BoundAddr = ln.Addr().String()
            httpSrv := &http.Server{
                Handler:   mux,
                TLSConfig: &tls.Config{MinVersion: tls.VersionTLS12},
            }
            s.RawSrv = httpSrv
            lamRunLifecycleHooks(s.OnListenHooks, s)
            httpSrv.ServeTLS(ln, certFile, keyFile)
        }
    }

    func listenTLSBackground(self, port: int, certFile: str, keyFile: str) {
        #- Non-blocking ``listenTLS``. Same caveats as ``listenBackground``. -#
        go! {
            srvLocal := s
            mux := http.NewServeMux()
            mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
                lamServerHandle(srvLocal, w, r)
            })
            lamRunLifecycleHooks(s.OnReadyHooks, s)
            ln, err := net.Listen("tcp", fmt.Sprintf(":%d", port))
            if err != nil {
                panic("Server.listenTLSBackground: " + err.Error())
            }
            s.BoundAddr = ln.Addr().String()
            httpSrv := &http.Server{
                Handler:   mux,
                TLSConfig: &tls.Config{MinVersion: tls.VersionTLS12},
            }
            s.RawSrv = httpSrv
            lamRunLifecycleHooks(s.OnListenHooks, s)
            go func() { httpSrv.ServeTLS(ln, certFile, keyFile) }()
            time.Sleep(20 * time.Millisecond)
        }
    }

    # ─── Introspection / testing ──────────────────────────────
    # The bound listener address is exposed directly as
    # ``self.boundAddr`` (eg ``"127.0.0.1:46531"``). Empty until
    # ``listen()`` / ``listenBackground()`` returns successfully.

    func openapi(self, info: any = None) -> str {
        #- Generate an OpenAPI 3.0 document covering every route
        registered via ``routeOpts``(or any of the `` * Opts``
        helpers). Routes registered via the bare verb shortcuts
        are still included but get empty schemas / descriptions.
        Returns the document as JSON - serialised string. Pair with
        ``server.get("/openapi.json", lambda req, res: res.json(srv.openapi()))``
        to expose it.

        ``info`` is an optional ``dict[str, any]`` honoured for
        the ``info`` block(``title`` / ``version`` / ``description``).
        Sensible defaults are used when omitted. -  #
        go! {
            // ── info block ────────────────────────────────
            title := "Lammergeier API"
            version := "1.0.0"
            description := ""
            if m, ok := info.(map[string]interface{}); ok {
                if v, ok := m["title"].(string); ok && v != "" {
                    title = v
                }
                if v, ok := m["version"].(string); ok && v != "" {
                    version = v
                }
                if v, ok := m["description"].(string); ok {
                    description = v
                }
            }
            doc := map[string]interface{}{
                "openapi": "3.0.3",
                "info": map[string]interface{}{
                    "title":       title,
                    "version":     version,
                    "description": description,
                },
                "paths": map[string]interface{}{},
            }
            paths := doc["paths"].(map[string]interface{})

            // ── per-route operations ──────────────────────
            for _, rr := range s.Routes {
                route, ok := rr.(lamRoute)
                if !ok {
                    continue
                }
                if route.opts != nil && route.opts.Hidden {
                    continue
                }

                // Convert “:id“ → “{id}“ for OpenAPI path syntax
                // and skip wildcards (“*“) since OpenAPI lacks a
                // direct equivalent.
                segs := make([]string, 0, len(route.segments))
                hasWild := false
                for _, seg := range route.segments {
                    if seg == "*" {
                        hasWild = true
                        break
                    }
                    if strings.HasPrefix(seg, ":") {
                        segs = append(segs, "{"+seg[1:]+"}")
                    } else {
                        segs = append(segs, seg)
                    }
                }
                if hasWild {
                    continue
                }
                pattern := "/" + strings.Join(segs, "/")
                if pattern == "/" && len(segs) == 1 && segs[0] == "" {
                    pattern = "/"
                }

                op := map[string]interface{}{
                    "responses": map[string]interface{}{},
                }
                if route.opts != nil {
                    if route.opts.Summary != "" {
                        op["summary"] = route.opts.Summary
                    }
                    if route.opts.Description != "" {
                        op["description"] = route.opts.Description
                    }
                    if route.opts.OperationId != "" {
                        op["operationId"] = route.opts.OperationId
                    }
                    if route.opts.Deprecated {
                        op["deprecated"] = true
                    }
                    if len(route.opts.Tags) > 0 {
                        tagsOut := make([]interface{}, 0, len(route.opts.Tags))
                        for _, t := range route.opts.Tags {
                            tagsOut = append(tagsOut, t)
                        }
                        op["tags"] = tagsOut
                    }

                    // Path / query parameters from path pattern + schemas.
                    var params []interface{}
                    for _, seg := range route.segments {
                        if !strings.HasPrefix(seg, ":") {
                            continue
                        }
                        params = append(params, map[string]interface{}{
                            "name":     seg[1:],
                            "in":       "path",
                            "required": true,
                            "schema":   map[string]interface{}{"type": "string"},
                        })
                    }
                    if route.opts.QuerySchema != "" {
                        if qs := lamSchemaProperties(route.opts.QuerySchema); qs != nil {
                            for name, sch := range qs {
                                params = append(params, map[string]interface{}{
                                    "name":   name,
                                    "in":     "query",
                                    "schema": sch,
                                })
                            }
                        }
                    }
                    if len(params) > 0 {
                        op["parameters"] = params
                    }

                    // Request body.
                    if route.opts.BodySchema != "" {
                        format := route.opts.SchemaFormat
                        if format == "" {
                            format = "json"
                        }
                        ct := "application/json"
                        if format == "yaml" {
                            ct = "application/yaml"
                        }
                        if format == "xml" {
                            ct = "application/xml"
                        }
                        if len(route.opts.Consumes) > 0 {
                            ct = route.opts.Consumes[0]
                        }
                        var schema interface{}
                        switch format {
                        case "yaml":
                            if schemaText, err := lamSchemaYAMLToJSON(route.opts.BodySchema); err == nil {
                                _ = json.Unmarshal([]byte(schemaText), &schema)
                            }
                        case "xml":
                            schema = map[string]interface{}{"type": "string", "format": "xml", "x-xsd": route.opts.BodySchema}
                        default:
                            _ = json.Unmarshal([]byte(route.opts.BodySchema), &schema)
                        }
                        if schema == nil {
                            schema = map[string]interface{}{}
                        }
                        op["requestBody"] = map[string]interface{}{
                            "required": true,
                            "content": map[string]interface{}{
                                ct: map[string]interface{}{"schema": schema},
                            },
                        }
                    }

                    // Responses.
                    responses := op["responses"].(map[string]interface{})
                    for code, schemaText := range route.opts.ResponseSchemas {
                        var schema interface{}
                        if err := json.Unmarshal([]byte(schemaText), &schema); err != nil {
                            schema = map[string]interface{}{}
                        }
                        ct := "application/json"
                        if len(route.opts.Produces) > 0 {
                            ct = route.opts.Produces[0]
                        }
                        responses[code] = map[string]interface{}{
                            "description": http.StatusText(parseStatusOr200(code)),
                            "content": map[string]interface{}{
                                ct: map[string]interface{}{"schema": schema},
                            },
                        }
                    }
                    if len(responses) == 0 {
                        responses["default"] = map[string]interface{}{
                            "description": "Default response",
                        }
                    }
                }

                // Merge into paths[pattern][method].
                node, ok := paths[pattern].(map[string]interface{})
                if !ok {
                    node = map[string]interface{}{}
                    paths[pattern] = node
                }
                node[strings.ToLower(route.method)] = op
            }

            b, err := json.MarshalIndent(doc, "", "  ")
            if err != nil {
                return "{}"
            }
            return string(b)
        }
    }

    func listRoutes(self) -> list[any] {
        #- Return every registered route as ``[{"method": ..., "path": ...,
        "summary": ..., "tags": ..., "meta": ...
    }
    , …]``. Routes
    registered without `` * Opts`` get empty ``summary`` / ``tags``.
    Useful for debug dashboards, route audits, OpenAPI generation,
    or just printing on startup. -  #
        go! {
            out := []interface{}{}
            for _, rr := range s.Routes {
                route, ok := rr.(lamRoute)
                if !ok {
                    continue
                }
                pattern := "/" + strings.Join(route.segments, "/")
                if pattern == "/" && len(route.segments) == 1 && route.segments[0] == "" {
                    pattern = "/"
                }
                entry := map[string]interface{}{
                    "method":     route.method,
                    "path":       pattern,
                    "summary":    "",
                    "tags":       []interface{}{},
                    "meta":       map[string]interface{}{},
                    "timeoutMs":  0,
                    "streamBody": false,
                }
                if route.opts != nil {
                    entry["summary"] = route.opts.Summary
                    tagsOut := make([]interface{}, 0, len(route.opts.Tags))
                    for _, t := range route.opts.Tags {
                        tagsOut = append(tagsOut, t)
                    }
                    entry["tags"] = tagsOut
                    if route.opts.Meta != nil {
                        // Shallow copy so callers can mutate without
                        // affecting the route registration.
                        m := map[string]interface{}{}
                        for k, v := range route.opts.Meta {
                            m[k] = v
                        }
                        entry["meta"] = m
                    }
                    if route.opts.TimeoutMs > 0 {
                        entry["timeoutMs"] = route.opts.TimeoutMs
                    }
                    if route.opts.StreamBody {
                        entry["streamBody"] = true
                    }
                }
                out = append(out, entry)
            }
            return out
        }
    }

    func printRoutes(self) -> str {
    #- Return every registered route as a human-readable
    string, one per line, sorted by path then method.
    Meant for startup banners, CLI `` - - print - routes``
    flags, and ad - hoc debugging. Fastify users will
    recognise the ``METHOD / path < flags > `` shape.

    Each line looks like::

    GET / hello summary = "Say hi" tags = [greeting]
    POST / uploads[stream] bodyLimit = 10485760
    PUT / items /: id[deprecated]

    Flags(square - bracketed) appear only when the route has
    them set: ``[deprecated]``, ``[hidden]``, ``[stream]``
    (streamBody), ``[timeout = NNNms]``. The trailing
    ``key = value`` pairs are omitted when empty / unset. -  #
        go! {
            type routeLine struct {
                method, path, rest string
                key                string
            }
            lines := []routeLine{}
            maxMethod := 3 // min width so GET/PUT line up
            maxPath := 1
            for _, rr := range s.Routes {
                route, ok := rr.(lamRoute)
                if !ok {
                    continue
                }
                pattern := "/" + strings.Join(route.segments, "/")
                if pattern == "/" && len(route.segments) == 1 && route.segments[0] == "" {
                    pattern = "/"
                }
                flags := []string{}
                kv := []string{}
                if route.opts != nil {
                    o := route.opts
                    if o.Deprecated {
                        flags = append(flags, "deprecated")
                    }
                    if o.Hidden {
                        flags = append(flags, "hidden")
                    }
                    if o.StreamBody {
                        flags = append(flags, "stream")
                    }
                    if o.TimeoutMs > 0 {
                        flags = append(flags, fmt.Sprintf("timeout=%dms", o.TimeoutMs))
                    }
                    if o.BodyLimit > 0 {
                        kv = append(kv, fmt.Sprintf("bodyLimit=%d", o.BodyLimit))
                    }
                    if o.OperationId != "" {
                        kv = append(kv, fmt.Sprintf("operationId=%s", o.OperationId))
                    }
                    if o.Summary != "" {
                        kv = append(kv, fmt.Sprintf("summary=%q", o.Summary))
                    }
                    if len(o.Tags) > 0 {
                        kv = append(kv, fmt.Sprintf("tags=[%s]", strings.Join(o.Tags, ",")))
                    }
                }
                flagStr := ""
                if len(flags) > 0 {
                    flagStr = "[" + strings.Join(flags, " ") + "]"
                }
                restParts := []string{}
                if flagStr != "" {
                    restParts = append(restParts, flagStr)
                }
                if len(kv) > 0 {
                    restParts = append(restParts, strings.Join(kv, " "))
                }
                lines = append(lines, routeLine{
                    method: route.method,
                    path:   pattern,
                    rest:   strings.Join(restParts, " "),
                    key:    pattern + " " + route.method,
                })
                if len(route.method) > maxMethod {
                    maxMethod = len(route.method)
                }
                if len(pattern) > maxPath {
                    maxPath = len(pattern)
                }
            }
            slices.SortFunc(lines, func(a, b routeLine) int { return strings.Compare(a.key, b.key) })
            var b strings.Builder
            for _, ln := range lines {
                b.WriteString(fmt.Sprintf("%-*s  %-*s", maxMethod, ln.method, maxPath, ln.path))
                if ln.rest != "" {
                    b.WriteString("  ")
                    b.WriteString(ln.rest)
                }
                b.WriteString("\n")
            }
            return b.String()
        }
    }

    func inject(self, method: str, path: str, body: str = "", headers: any = None) -> dict[str, any] {
    #- In-process test harness, à la Fastify's ``server.inject()``:
    run the full hook + route pipeline against a synthetic request
    without binding a port. Returns a ``dict`` with keys
    ``status``(int), ``body``(str), and ``headers``
    (dict[str, str]).

    Static - file mounts and SSE handlers are honoured
    streaming
    file responses fall back to in - memory bodies. WebSocket
    upgrades are * not * simulated — call them over a real listener. -  #
        go! {
            req := NewRequest()
            req.Method = strings.ToUpper(method)
            // Parse the URL so query strings work.
            u, err := url.Parse(path)
            if err == nil {
                req.Path = u.Path
                for k, vs := range u.Query() {
                    if len(vs) > 0 {
                        req.Query[k] = vs[0]
                    }
                }
            } else {
                req.Path = path
            }
            req.Body = body
            if hMap, ok := headers.(map[string]string); ok {
                for k, v := range hMap {
                    req.Headers[k] = v
                }
            }
            req.RemoteAddr = "inject"

            // Body-limit check. http path uses MaxBytesReader; we just
            // measure the synthetic body length here.
            res := NewResponse()
            if s.BodyLimit > 0 && len(body) > int(s.BodyLimit) {
                res.Status = 413
                res.Headers["Content-Type"] = "text/plain; charset=utf-8"
                res.Body = "413 payload too large"
                res.Sent = true
            } else {
                // Top-level shield around the dispatcher — see
                // “lamServerHandle“ for the rationale. Without
                // it, a buggy plugin would crash the test process
                // instead of yielding a structured 500.
                func() {
                    defer func() {
                        if rec := recover(); rec != nil {
                            lamHandlePanic(s, req, res, rec)
                        }
                    }()
                    lamServerDispatch(s, req, res)
                }()
            }
            // If a handler asked to stream a file, surface the bytes
            // through res.Body so tests can assert against them.
            if !res.Hijacked && res.StreamFallback != nil && res.Body == "" {
                if fb, ok := res.StreamFallback.(func() string); ok {
                    res.Body = fb()
                }
            }
            // Snapshot headers (split joined Set-Cookie values).
            outHeaders := map[string]string{}
            for k, v := range res.Headers {
                outHeaders[k] = v
            }
            out := map[string]interface{}{
                "status":  int(res.Status),
                "body":    res.Body,
                "headers": outHeaders,
            }
            return out
        }
    }
}

go! {
    // ─── Lifecycle hook runners ────────────────────────────
    // App-lifecycle hooks (onReady / onListen / onClose) take the
    // server as their only argument; runtime errors are swallowed
    // with a log line so a buggy plugin can't crash startup.
    func lamRunLifecycleHooks(hooks []interface{}, srv *Server) {
        for _, h := range hooks {
            if fn, ok := h.(func(*Server)); ok {
                func() {
                    defer func() {
                        if rec := recover(); rec != nil && srv.Debug {
                            fmt.Fprintf(os.Stderr, "Vulture: lifecycle hook panic: %v\n", rec)
                        }
                    }()
                    fn(srv)
                }()
            }
        }
    }

    func lamRunLifecycleHooksReverse(hooks []interface{}, srv *Server) {
        for i := len(hooks) - 1; i >= 0; i-- {
            if fn, ok := hooks[i].(func(*Server)); ok {
                func() {
                    defer func() {
                        if rec := recover(); rec != nil && srv.Debug {
                            fmt.Fprintf(os.Stderr, "Vulture: lifecycle hook panic: %v\n", rec)
                        }
                    }()
                    fn(srv)
                }()
            }
        }
    }

    // ─── Validation + serialization helpers ─────────────────
    func lamFailValidation(srv *Server, req *Request, res *Response,
        where string, errs []string) {
        res.Status = 400
        if res.Headers == nil {
            res.Headers = map[string]string{}
        }

        // Custom formatter — matches Fastify's
        // “setSchemaErrorFormatter“ hook. Recovers any panic the
        // user's formatter raises and falls back to the built-in
        // envelope so a buggy formatter can never 500 the server
        // silently.
        if srv != nil && srv.SchemaErrorFormatter != nil {
            fmtted, ok := func() (interface{}, bool) {
                defer func() {
                    if r := recover(); r != nil {
                        // Swallow; ok stays false.
                    }
                }()
                switch f := srv.SchemaErrorFormatter.(type) {
                case func(string, []string, *Request) interface{}:
                    return f(where, errs, req), true
                case func(string, []string, *Request) map[string]interface{}:
                    return f(where, errs, req), true
                case func(string, []string, *Request) string:
                    return f(where, errs, req), true
                }
                return nil, false
            }()
            if ok {
                switch body := fmtted.(type) {
                case string:
                    res.Headers["Content-Type"] = "text/plain; charset=utf-8"
                    res.Body = body
                    res.Sent = true
                    return
                case map[string]interface{}, []interface{}:
                    if b, err := json.Marshal(body); err == nil {
                        res.Headers["Content-Type"] = "application/json; charset=utf-8"
                        res.Body = string(b)
                        res.Sent = true
                        return
                    }
                case nil:
                // Formatter explicitly returned nil → fall
                // through to default envelope.
                default:
                    // Arbitrary value: best-effort JSON.
                    if b, err := json.Marshal(body); err == nil {
                        res.Headers["Content-Type"] = "application/json; charset=utf-8"
                        res.Body = string(b)
                        res.Sent = true
                        return
                    }
                }
            }
        }

        res.Headers["Content-Type"] = "application/json; charset=utf-8"
        payload := map[string]interface{}{
            "statusCode": 400,
            "error":      "Bad Request",
            "message":    "validation failed: " + where,
            "validation": errs,
        }
        if b, err := json.Marshal(payload); err == nil {
            res.Body = string(b)
        } else {
            res.Body = `{"statusCode":400,"error":"Bad Request","message":"validation failed"}`
        }
        res.Sent = true
    }

    // lamProjectToSchema walks “val“ against the parsed schema
    // “schema“ and drops keys that aren't in “properties“ when
    // “additionalProperties: false“ is set. Recurses into nested
    // objects/arrays. This approximates Fastify's
    // “fast-json-stringify“ whitelist behaviour. Schemas that
    // omit “additionalProperties“ (the default) are left alone.
    func lamProjectToSchema(val interface{}, schema map[string]interface{}) interface{} {
        if schema == nil {
            return val
        }
        switch v := val.(type) {
        case map[string]interface{}:
            props, _ := schema["properties"].(map[string]interface{})
            additional, hasAdditional := schema["additionalProperties"]
            allowExtra := true
            if hasAdditional {
                if b, ok := additional.(bool); ok && !b {
                    allowExtra = false
                }
            }
            out := map[string]interface{}{}
            for k, child := range v {
                if !allowExtra {
                    if _, known := props[k]; !known {
                        continue
                    }
                }
                if subSchema, ok := props[k].(map[string]interface{}); ok {
                    out[k] = lamProjectToSchema(child, subSchema)
                } else {
                    out[k] = child
                }
            }
            return out
        case []interface{}:
            items, _ := schema["items"].(map[string]interface{})
            if items == nil {
                return v
            }
            out := make([]interface{}, len(v))
            for i, child := range v {
                out[i] = lamProjectToSchema(child, items)
            }
            return out
        }
        return val
    }

    // lamSerializeResponse pulls the matching response schema (exact
    // status, “Nxx“ family, then “default“) and validates the
    // outgoing body. When the schema sets “additionalProperties:
    // false“ we also project the body down to schema-allowed keys
    // (Fastify-compatible whitelist behaviour). On validation
    // failure the original body survives but a stderr log line is
    // emitted in debug mode.
    func lamSerializeResponse(srv *Server, req *Request, res *Response, schemas map[string]string) {
        if len(schemas) == 0 || res.Body == "" {
            return
        }
        code := res.Status
        if code == 0 {
            code = 200
        }
        keyExact := strconv.Itoa(code)
        keyFamily := fmt.Sprintf("%dxx", code/100)
        text, ok := schemas[keyExact]
        if !ok {
            text, ok = schemas[keyFamily]
        }
        if !ok {
            text, ok = schemas["default"]
        }
        if !ok || text == "" {
            return
        }

        var schemaDoc map[string]interface{}
        _ = json.Unmarshal([]byte(text), &schemaDoc)
        var body interface{}
        if err := json.Unmarshal([]byte(res.Body), &body); err != nil {
            return
        }

        // Project first so validation runs against the canonical
        // shape (extras don't trigger "additionalProperties not
        // allowed" errors after projection drops them).
        projected := lamProjectToSchema(body, schemaDoc)

        schemaText := lamResolveSchemaRefs(text, srv.SharedSchemas)
        if failure := lamSchemaValidateValue(schemaText, lamJSONMust(projected)); failure != nil {
            if srv.Debug {
                fmt.Fprintf(os.Stderr, "Vulture: response schema mismatch: %v\n", lamSchemaFailureMessages(failure))
            }
            return
        }
        if b, err := json.Marshal(projected); err == nil {
            res.Body = string(b)
        }
    }

    // ─── The dispatcher ─────────────────────────────────────
    //
    // “lamServerDispatch“ is the transport-agnostic core: given a
    // populated Request and a fresh Response, it runs the entire
    // Fastify-style hook ladder around route matching:
    //
    //  onRequest   →  preParsing  →  parser  →  preValidation
    //              →  schema      →  preHandler  →  handler
    //              →  preSerialization  →  serializer
    //              →  onSend      →  onResponse
    //
    // and mutates the Response in place. It does not write to the
    // network — that's the caller's job. Both the HTTP entry point
    // (“lamServerHandle“) and the in-process test harness
    // (“Server.inject“) call this.
    func lamServerDispatch(srv *Server, req *Request, res *Response) {
        // ── Trust-proxy thread: stash the configured header names on
        //
        //  req.Ctx so Request.realIP / Request.realScheme see them.
        //  Done here (rather than in the HTTP entry point alone) so
        //  inject() also honours trustProxy when its synthetic
        //  request carries a forwarded header.
        if len(srv.TrustProxyHeaders) > 0 {
            req.Ctx.Set("__lamTrustHeaders", srv.TrustProxyHeaders)
            req.Ctx.Set("__lamTrustHops", srv.TrustProxyHops)
        }

        // Capture a reference timestamp the moment we enter the
        // dispatcher so “req.startTime()“ / “res.elapsedTime()“
        // (and any “onResponse“ hook measuring tail latency) have
        // a single monotonic anchor. Mirrored on both contexts so
        // helpers that only carry “res“ (server-timing, access
        // logs) can read it without plumbing “req“ through.
        lamDispatchStart := time.Now()
        req.Ctx.Set("__lamReqStart", lamDispatchStart)
        res.Ctx["__lamReqStart"] = lamDispatchStart

        // Mirror the request path + matched pattern onto both the
        // request and response contexts so helpers like
        // “Response.paginate(...)“ can build canonical URLs
        // without plumbing “req“ through every call. The mirror
        // on “res“ is what the paginator reads first (it's only
        // given the Response).
        req.Ctx.Set("__lamReqPath", req.Path)
        res.Ctx["__lamReqPath"] = req.Path

        // ── Decorator threading. Make all three decorator scopes
        //
        //  (server / request / reply) reachable to handlers via
        //  .dec(name). We pass the *live* maps so plugins
        //  registering decorators after listen() begins still see
        //  them on subsequent requests.
        if len(srv.Decorators) > 0 {
            req.Ctx.Set("__lamServerDecorators", srv.Decorators)
        }
        if len(srv.RequestDecorators) > 0 {
            req.Ctx.Set("__lamReqDecorators", srv.RequestDecorators)
        }
        if len(srv.ReplyDecorators) > 0 {
            res.Ctx["__lamRespDecorators"] = srv.ReplyDecorators
        }

        // ── Static-file mounts: served before route matching so
        //
        //  static URLs never touch the routes table.
        for _, m := range srv.StaticMounts {
            mount, ok := m.([2]string)
            if !ok {
                continue
            }
            urlPrefix := mount[0]
            dir := mount[1]
            if !strings.HasPrefix(req.Path, urlPrefix) {
                continue
            }
            rel := strings.TrimPrefix(req.Path, urlPrefix)
            if rel == "" || strings.HasSuffix(rel, "/") {
                rel += "index.html"
            }
            absDir, errA := filepath.Abs(dir)
            absFile, errB := filepath.Abs(filepath.Join(dir, filepath.FromSlash(rel)))
            if errA != nil || errB != nil ||
                !strings.HasPrefix(absFile, absDir+string(filepath.Separator)) &&
                    absFile != absDir {
                res.Status = 403
                res.Headers["Content-Type"] = "text/plain; charset=utf-8"
                res.Body = "403 forbidden"
                res.Sent = true
                break
            }
            data, err := os.ReadFile(absFile)
            if err != nil {
                continue
            }
            ct := mime.TypeByExtension(filepath.Ext(absFile))
            if ct == "" {
                ct = http.DetectContentType(data)
            }
            res.Headers["Content-Type"] = ct
            res.Body = string(data)
            res.Sent = true
            break
        }

        // ── Route matching. Trie-backed for speed when populated
        //
        //  (route()/routeOpts() index into it on registration).
        //  Falls back to a linear scan over ``srv.Routes`` so
        //  plugins that mutate ``srv.Routes`` directly (some
        //  pre-trie plugins do) still match.
        segs := lamSplitPath(req.Path)
        var matched *lamRoute
        var params map[string]string
        var pathOnlyMethods []string
        if !res.Sent {
            if t, ok := srv.RouteTrie.(*lamRouteTrie); ok && t != nil {
                matched, params, pathOnlyMethods = lamTrieMatch(t, req.Method, segs)
            }
            if matched == nil {
                for _, rr := range srv.Routes {
                    route, ok := rr.(lamRoute)
                    if !ok {
                        continue
                    }
                    ps, ok := lamMatchRoute(route, req.Method, segs)
                    if ok {
                        rcopy := route
                        matched = &rcopy
                        params = ps
                        break
                    }
                    if len(route.segments) == len(segs) {
                        pathOk := true
                        for i, rs := range route.segments {
                            if strings.HasPrefix(rs, ":") {
                                continue
                            }
                            if rs != segs[i] {
                                pathOk = false
                                break
                            }
                        }
                        if pathOk {
                            // Only add methods we haven't already seen
                            // from the trie path-only list.
                            seen := false
                            for _, m := range pathOnlyMethods {
                                if m == route.method {
                                    seen = true
                                    break
                                }
                            }
                            if !seen {
                                pathOnlyMethods = append(pathOnlyMethods, route.method)
                            }
                        }
                    }
                }
            }
        }
        if params == nil {
            params = map[string]string{}
        }
        for k, v := range params {
            req.Params[k] = v
        }
        // Stash the matched route on req.Ctx so panic recovery
        // (which runs after the dispatcher's local “matched“ is
        // out of scope) can find route-level OnError hooks. Also
        // mirror it onto res.Ctx so “Response.serialize“ can
        // pick up the response schema without needing a handle to
        // “req“.
        if matched != nil {
            req.Ctx.Set("__lamMatchedRoute", matched)
            res.Ctx["__lamMatchedRoute"] = matched
        }

        runEarlyHooks := func(hooks []interface{}) {
            for _, h := range hooks {
                if res.Sent {
                    return
                }
                if fn, ok := h.(func(*Request, *Response)); ok {
                    callHook(srv, fn, req, res)
                }
            }
        }
        runFinalHooks := func(hooks []interface{}) {
            for _, h := range hooks {
                if fn, ok := h.(func(*Request, *Response)); ok {
                    callHook(srv, fn, req, res)
                }
            }
        }
        runRouteHook := func(opt interface{}) {
            if opt == nil || res.Sent {
                return
            }
            if fn, ok := opt.(func(*Request, *Response)); ok {
                callHook(srv, fn, req, res)
            }
        }
        runRouteHookFinal := func(opt interface{}) {
            if opt == nil {
                return
            }
            if fn, ok := opt.(func(*Request, *Response)); ok {
                callHook(srv, fn, req, res)
            }
        }

        // ── 1. onRequest
        if !res.Sent {
            runEarlyHooks(srv.OnRequestHooks)
        }

        // ── 2. body limit (per-route)
        if !res.Sent && matched != nil && matched.opts != nil && matched.opts.BodyLimit > 0 {
            if len(req.Body) > matched.opts.BodyLimit {
                res.Status = 413
                res.Headers["Content-Type"] = "text/plain; charset=utf-8"
                res.Body = "413 payload too large"
                res.Sent = true
            }
        }

        // ── 3. preParsing (global → route)
        if !res.Sent {
            runEarlyHooks(srv.PreParsingHooks)
        }
        if matched != nil && matched.opts != nil {
            runRouteHook(matched.opts.PreParsing)
        }

        // ── 4. content-type parser. User-registered parsers win;
        //
        //  builtins (json / form / text) cover the rest.
        if !res.Sent && req.Body != "" {
            ct := lamContentTypeKey(lamReadHeader(req, "Content-Type"))
            handled := false
            if ct != "" && len(srv.ContentTypeParsers) > 0 {
                if parser, ok := srv.ContentTypeParsers[ct]; ok && parser != nil {
                    if fn, ok := parser.(func(*Request) interface{}); ok {
                        func() {
                            defer func() { _ = recover() }()
                            req.Ctx.Set("__parsed", fn(req))
                            handled = true
                        }()
                    }
                }
            }
            if !handled {
                if val, parsed := lamBuiltinParse(req); parsed {
                    req.Ctx.Set("__parsed", val)
                }
            }
        }

        // ── 5. preValidation (global → route)
        if !res.Sent {
            runEarlyHooks(srv.PreValidationHooks)
        }
        if matched != nil && matched.opts != nil {
            runRouteHook(matched.opts.PreValidation)
        }

        // ── 6. schema validation (route-driven)
        if !res.Sent && matched != nil && matched.opts != nil {
            opts := matched.opts
            if opts.BodySchema != "" {
                format := opts.SchemaFormat
                if format == "" {
                    format = "json"
                }
                schemaText := opts.BodySchema
                if format == "json" {
                    schemaText = lamResolveSchemaRefs(schemaText, srv.SharedSchemas)
                }
                var failure *lamSchemaFailure
                switch format {
                case "json":
                    if v := req.Ctx.Get("__parsed", nil); v != nil {
                        failure = lamSchemaValidateValue(schemaText, lamJSONMust(v))
                    } else if req.Body != "" {
                        failure = lamSchemaValidateText(schemaText, req.Body)
                    } else {
                        failure = lamSchemaValidateText(schemaText, "null")
                    }
                case "yaml":
                    failure = lamSchemaValidateYAML(schemaText, req.Body)
                case "xml":
                    failure = lamSchemaValidateXML(schemaText, req.Body)
                default:
                    failure = &lamSchemaFailure{kind: "SchemaFormatError", message: "unsupported schema format: " + format}
                }
                if failure != nil && failure.kind == "SchemaCompileError" &&
                    format == "json" && lamMissingSharedSchemaRef(opts.BodySchema, srv.SharedSchemas) {
                    failure = nil
                }
                if failure != nil {
                    lamFailValidation(srv, req, res, "body", lamSchemaFailureMessages(failure))
                }
            }
            if !res.Sent && opts.QuerySchema != "" {
                schemaText := lamResolveSchemaRefs(opts.QuerySchema, srv.SharedSchemas)
                failure := lamSchemaValidateValue(schemaText, lamJSONMust(lamQueryForSchema(req.Query)))
                if failure != nil {
                    lamFailValidation(srv, req, res, "querystring", lamSchemaFailureMessages(failure))
                }
            }
            if !res.Sent && opts.ParamsSchema != "" {
                schemaText := lamResolveSchemaRefs(opts.ParamsSchema, srv.SharedSchemas)
                failure := lamSchemaValidateValue(schemaText, lamJSONMust(lamParamsForSchema(req.Params)))
                if failure != nil {
                    lamFailValidation(srv, req, res, "params", lamSchemaFailureMessages(failure))
                }
            }
            if !res.Sent && opts.HeadersSchema != "" {
                schemaText := lamResolveSchemaRefs(opts.HeadersSchema, srv.SharedSchemas)
                failure := lamSchemaValidateValue(schemaText, lamJSONMust(lamHeadersAsLowerMap(req.Headers)))
                if failure != nil {
                    lamFailValidation(srv, req, res, "headers", lamSchemaFailureMessages(failure))
                }
            }
        }

        // ── 7. preHandler (global → route)
        if !res.Sent {
            runEarlyHooks(srv.PreHandlerHooks)
        }
        if !res.Sent && matched != nil && matched.opts != nil {
            runRouteHook(matched.opts.PreHandler)
        }

        // ── 8. handler / 404 / 405
        if !res.Sent {
            if matched != nil {
                if fn, ok := matched.handler.(func(*Request, *Response)); ok {
                    callHandler(srv, fn, req, res)
                } else {
                    res.Status = 500
                    res.Body = "internal error: route handler has wrong signature"
                    res.Sent = true
                }
                // Fastify-style “reply.callNotFound()“ — the handler
                // flagged a delegation, so run the registered not-found
                // handler (or the bare-404 fallback) *after* the real
                // handler returned. Reset Sent so the delegate can
                // write a fresh body/status.
                if flag, _ := res.Ctx["__lamCallNotFound"].(bool); flag {
                    delete(res.Ctx, "__lamCallNotFound")
                    res.Sent = false
                    res.Body = ""
                    res.Headers = map[string]string{}
                    if srv.NotFoundHandler != nil {
                        if fn, ok := srv.NotFoundHandler.(func(*Request, *Response)); ok {
                            callHandler(srv, fn, req, res)
                        } else {
                            res.Status = 404
                            res.Body = "404 not found"
                            res.Sent = true
                        }
                    } else {
                        res.Status = 404
                        res.Body = "404 not found"
                        res.Sent = true
                    }
                }
            } else if len(pathOnlyMethods) > 0 {
                res.Status = 405
                res.Headers["Allow"] = strings.Join(pathOnlyMethods, ", ")
                res.Headers["Content-Type"] = "text/plain; charset=utf-8"
                res.Body = "405 method not allowed"
                res.Sent = true
            } else if srv.NotFoundHandler != nil {
                if fn, ok := srv.NotFoundHandler.(func(*Request, *Response)); ok {
                    callHandler(srv, fn, req, res)
                } else {
                    res.Status = 404
                    res.Body = "404 not found"
                    res.Sent = true
                }
            } else {
                res.Status = 404
                res.Body = "404 not found"
                res.Sent = true
            }
        }

        // ── 9. preSerialization (after the body is in place; before
        //
        //  the schema-driven serializer runs).
        runFinalHooks(srv.PreSerializationHooks)
        if matched != nil && matched.opts != nil {
            runRouteHookFinal(matched.opts.PreSerialization)
        }

        // ── 10. response schema serializer
        if matched != nil && matched.opts != nil && len(matched.opts.ResponseSchemas) > 0 {
            lamSerializeResponse(srv, req, res, matched.opts.ResponseSchemas)
        }

        // ── 11. onSend (last chance to mutate body / headers)
        runFinalHooks(srv.OnSendHooks)
        if matched != nil && matched.opts != nil {
            runRouteHookFinal(matched.opts.OnSend)
        }

        // ── 12. onResponse (observational; route hook first, broader
        //
        //  global observers afterwards).
        if matched != nil && matched.opts != nil && matched.opts.OnResponse != nil {
            if fn, ok := matched.opts.OnResponse.(func(*Request, *Response)); ok {
                callHook(srv, fn, req, res)
            }
        }
        runFinalHooks(srv.OnResponseHooks)

        if res.Status == 0 {
            res.Status = 200
        }
    }

    // lamPickRouteForRequest peeks at the route table to find the
    // route a request would dispatch to *without* mutating req or
    // running any hooks. Used by the HTTP entry point to read
    // “opts.TimeoutMs“ before kicking off the timeout watcher.
    // Returns nil for unmatched paths (404s, static-mount-only
    // hits) — those inherit the server-level default.
    func lamPickRouteForRequest(srv *Server, method, path string) *lamRoute {
        if srv == nil {
            return nil
        }
        segs := lamSplitPath(path)
        if t, ok := srv.RouteTrie.(*lamRouteTrie); ok && t != nil {
            r, _, _ := lamTrieMatch(t, method, segs)
            if r != nil {
                return r
            }
        }
        for _, rr := range srv.Routes {
            route, ok := rr.(lamRoute)
            if !ok {
                continue
            }
            if _, ok := lamMatchRoute(route, method, segs); ok {
                rcopy := route
                return &rcopy
            }
        }
        return nil
    }

    // lamWriteTimeoutResponse fills “res“ with a Fastify-style 408
    // body. Hooks that mutated “res“ already (status, headers,
    // body) win — we only fill blanks so user-customised payloads
    // survive.
    //
    // Note: “NewResponse()“ initialises “Status“ to 200, which
    // we treat as "untouched" here so a fresh timeout response
    // always defaults to 408. Hooks that want a different code
    // (eg 504) just call “res.code(504)“ and we leave it alone.
    func lamWriteTimeoutResponse(res *Response, timeoutMs int) {
        if res.Status == 0 || res.Status == 200 {
            res.Status = 408
        }
        if res.Headers == nil {
            res.Headers = map[string]string{}
        }
        if _, set := res.Headers["Content-Type"]; !set {
            res.Headers["Content-Type"] = "application/json; charset=utf-8"
        }
        if res.Body == "" {
            payload := map[string]interface{}{
                "statusCode": res.Status,
                "error":      http.StatusText(res.Status),
                "message":    fmt.Sprintf("request handler exceeded the %d ms timeout", timeoutMs),
                "timeoutMs":  timeoutMs,
            }
            if b, err := json.Marshal(payload); err == nil {
                res.Body = string(b)
            } else {
                res.Body = fmt.Sprintf(
                    `{"statusCode":%d,"error":%q,"message":"request timeout","timeoutMs":%d}`,
                    res.Status, http.StatusText(res.Status), timeoutMs,
                )
            }
        }
        res.Sent = true
    }

    // lamRunTimeoutHooks fires the registered onTimeout hooks. Each
    // hook gets the *Request and a fresh *Response (the same one the
    // dispatcher will eventually write). Panics inside a hook are
    // logged in debug mode and otherwise swallowed — one buggy
    // observer doesn't get to take the request down twice.
    func lamRunTimeoutHooks(srv *Server, req *Request, res *Response) {
        for _, h := range srv.OnTimeoutHooks {
            func(hook interface{}) {
                defer func() {
                    if rec := recover(); rec != nil && srv.Debug {
                        fmt.Fprintf(os.Stderr,
                            "Vulture: onTimeout panic: %v\n", rec)
                    }
                }()
                switch fn := hook.(type) {
                case func(*Request, *Response):
                    fn(req, res)
                case func(*Request):
                    fn(req)
                }
            }(h)
        }
    }

    // ─── HTTP entry point ─────────────────────────────────────
    func lamServerHandle(srv *Server, w http.ResponseWriter, r *http.Request) {
        // ── Top-level shield. Even if every inner “recover()“
        //
        //  fails — e.g. a panic in route matching, decorator
        //  threading, schema compile, header marshalling — the
        //  server stays alive and the client gets a clean 500.
        //  Gin behaves the same way; we mirror that contract so
        //  a buggy plugin can't take the listener down.
        defer func() {
            if rec := recover(); rec != nil {
                // Don't log when the panic is the deliberate
                // “http.ErrAbortHandler“ (Go's "abort silently")
                // sentinel; clients will already see the truncated
                // response.
                if rec == http.ErrAbortHandler {
                    return
                }
                if srv.Debug {
                    fmt.Fprintf(os.Stderr, "Vulture: top-level recover: %v\n", rec)
                }
                // Best effort: write a 500 if no headers have gone
                // out yet. “WriteHeader“ is a no-op on already-
                // committed responses.
                func() {
                    defer func() { _ = recover() }()
                    w.Header().Set("Content-Type", "text/plain; charset=utf-8")
                    w.WriteHeader(500)
                    if srv.Debug {
                        fmt.Fprintf(w, "internal server error: %v", rec)
                    } else {
                        io.WriteString(w, "internal server error")
                    }
                }()
            }
        }()

        // Build the Lam Request from net/http.
        req := NewRequest()
        req.Ctx = Context_fromNative(r.Context())
        req.Method = r.Method
        req.Path = r.URL.Path
        req.RemoteAddr = r.RemoteAddr
        // Stash the raw plumbing so handlers that need it (websocket
        // upgrade, raw flushing) can reach it.
        req.RawWriter = w
        req.RawHttp = r
        for k, vs := range r.Header {
            if len(vs) > 0 {
                req.Headers[k] = vs[0]
            }
        }
        for k, vs := range r.URL.Query() {
            if len(vs) > 0 {
                req.Query[k] = vs[0]
            }
        }
        // Surface the connection's actual scheme so realScheme()
        // can fall back to it when no Forwarded header is present.
        if r.TLS != nil {
            req.Ctx.Set("__lamReqScheme", "https")
        } else {
            req.Ctx.Set("__lamReqScheme", "http")
        }

        // ── Peek the matched route *before* reading the body so
        //
        //  per-route opt-ins (``streamBody``, ``timeoutMs``,
        //  ``bodyLimit``) apply to the transport layer, not just
        //  the dispatcher. The dispatcher does its own match
        //  again below — the routing cost is negligible (one
        //  trie walk) and the alternative would be splitting the
        //  dispatcher in half, which is worse.
        var peekedRoute *lamRoute = lamPickRouteForRequest(srv, req.Method, req.Path)

        // Effective per-request body limit. Route override beats
        // server default, matching the existing dispatcher rule.
        effBodyLimit := srv.BodyLimit
        if peekedRoute != nil && peekedRoute.opts != nil && peekedRoute.opts.BodyLimit > 0 {
            effBodyLimit = peekedRoute.opts.BodyLimit
        }

        // Body read with optional size cap (413 if exceeded).
        //
        // When the matched route opts into “streamBody“, skip
        // “io.ReadAll“ entirely — the handler reads chunks from
        // “req.bodyReader()“. “BodyLimit“ still caps the
        // reader via “MaxBytesReader“ so oversized uploads get
        // the usual 413 the moment the reader crosses the cap.
        var body []byte
        var readErr error
        streaming := peekedRoute != nil && peekedRoute.opts != nil && peekedRoute.opts.StreamBody
        if effBodyLimit > 0 {
            r.Body = http.MaxBytesReader(w, r.Body, int64(effBodyLimit))
        }
        if streaming {
            // Hand “r.Body“ straight to the handler. Dispatcher
            // clean-up for the reader happens lazily — Go's
            // “net/http“ closes any un-drained body when the
            // handler returns, so unused streams don't leak FDs.
            req.StreamBody = true
            req.Ctx.Set("__lamBodyReader", r.Body)
        } else {
            body, readErr = io.ReadAll(r.Body)
            r.Body.Close()
            req.Body = string(body)
        }

        res := NewResponse()

        // ── onRequestAbort wiring. Watch “r.Context().Done()“ on
        //
        //  a side goroutine; fire the hook chain the first time
        //  the client disconnects before dispatch finished. The
        //  ``handlerDone`` channel lets us distinguish normal
        //  completion from an abort — closing it from the main
        //  goroutine stops the watcher without triggering.
        handlerDone := make(chan struct{})
        if len(srv.OnRequestAbortHooks) > 0 {
            hooks := srv.OnRequestAbortHooks
            reqPtr := req
            go func() {
                select {
                case <-handlerDone:
                    return
                case <-r.Context().Done():
                }
                // Context is cancelled either way; we only fire
                // the abort hooks when the handler is still
                // running. If “handlerDone“ was already closed
                // the select above would have taken that branch.
                for _, h := range hooks {
                    func(hook interface{}) {
                        defer func() {
                            if rec := recover(); rec != nil && srv.Debug {
                                fmt.Fprintf(os.Stderr,
                                    "Vulture: onRequestAbort panic: %v\n", rec)
                            }
                        }()
                        switch fn := hook.(type) {
                        case func(*Request):
                            fn(reqPtr)
                        case func(*Request, *Response):
                            fn(reqPtr, nil)
                        }
                    }(h)
                }
            }()
            defer close(handlerDone)
        }

        if readErr != nil {
            var maxErr *http.MaxBytesError
            if errors.As(readErr, &maxErr) {
                res.Status = 413
                res.Headers["Content-Type"] = "text/plain; charset=utf-8"
                res.Body = "413 payload too large"
                res.Sent = true
            } else {
                res.Status = 400
                res.Headers["Content-Type"] = "text/plain; charset=utf-8"
                res.Body = "400 bad request"
                res.Sent = true
            }
        }

        if !res.Sent {
            // ── Per-request timeout. Per-route override beats the
            //
            //  server default; ``0`` on both means "no timeout"
            //  and we take the original synchronous fast path so
            //  we don't pay for goroutine + channel overhead on
            //  every request.
            //
            // Re-use the route we peeked at the top of
            // “lamServerHandle“ instead of walking the trie a
            // second time.
            timeoutMs := srv.RequestTimeoutMs
            if peekedRoute != nil && peekedRoute.opts != nil &&
                peekedRoute.opts.TimeoutMs > 0 {
                timeoutMs = peekedRoute.opts.TimeoutMs
            }

            dispatchSync := func() {
                defer func() {
                    if rec := recover(); rec != nil {
                        lamHandlePanic(srv, req, res, rec)
                    }
                }()
                lamServerDispatch(srv, req, res)
            }

            if timeoutMs <= 0 {
                // Fast path. Inner shield around the dispatcher —
                // covers the gaps *between* phases (route lookup,
                // decorator threading, schema compile) that the
                // per-hook recoveries can't see. We funnel
                // everything through “lamHandlePanic“ so
                // HttpError / setErrorHandler still apply.
                dispatchSync()
            } else {
                // Timeout path. Run the dispatcher in a goroutine,
                // race it against “ctx.Done()“. The handler
                // goroutine keeps running until it returns (Go
                // cannot force-cancel a goroutine); co-operative
                // handlers observe “r.Context().Done()“ and
                // bail out, but a non-cooperative handler — like
                // the slow “time.Sleep“ in our regression test
                // — will eventually wake and try to mutate
                // “res“. To avoid that race we *swap* “res“
                // for a fresh Response when the timeout wins, so
                // the handler scribbles into an orphaned object
                // that nobody ever writes to the wire.
                ctx, cancel := context.WithTimeout(r.Context(), time.Duration(timeoutMs)*time.Millisecond)
                defer cancel()
                req.RawHttp = r.WithContext(ctx)
                req.Ctx = Context_fromNative(ctx)
                done := make(chan struct{})
                go func() {
                    defer close(done)
                    dispatchSync()
                }()
                select {
                case <-done:
                // Handler completed before the deadline; “res“
                // holds the real result and we drop straight
                // through to the response-write loop below.
                case <-ctx.Done():
                    if errors.Is(ctx.Err(), context.DeadlineExceeded) {
                        timeoutRes := NewResponse()
                        // Carry over any matched-route bookkeeping
                        // the dispatcher already stashed on req
                        // (decorators, schema cache lookups) — the
                        // hooks expect those to be present.
                        lamRunTimeoutHooks(srv, req, timeoutRes)
                        lamWriteTimeoutResponse(timeoutRes, timeoutMs)
                        res = timeoutRes
                    } else {
                        // Client disconnect (the onRequestAbort
                        // path already fired). Wait for the
                        // dispatcher to finish so “res“ is
                        // consistent and not torn between two
                        // writers.
                        <-done
                    }
                }
            }
        }

        // ── If a handler hijacked the connection (eg WebSocket), the
        //
        //  handler itself owns the writer; we don't touch it again.
        if res.Hijacked {
            return
        }

        // ── Headers + status. Set-Cookie may carry multiple values
        //
        //  joined with "\n" (Response.cookie + Response.signedCookie);
        //  split them so the client receives distinct headers.
        for k, v := range res.Headers {
            if strings.EqualFold(k, "Set-Cookie") {
                for _, c := range strings.Split(v, "\n") {
                    if c != "" {
                        w.Header().Add("Set-Cookie", c)
                    }
                }
                continue
            }
            w.Header().Set(k, v)
        }

        // ── HTTP/2 server push (best-effort). Pushes must be issued
        //
        //  *before* WriteHeader, otherwise the client has already
        //  committed to a 1xx/2xx and the push frame is wasted.
        //  Failures are silent — push is a perf hint, not a contract.
        if pusher, ok := w.(http.Pusher); ok && len(res.Pushes) > 0 {
            for _, p := range res.Pushes {
                entry, ok := p.([2]string)
                if !ok {
                    continue
                }
                target, ct := entry[0], entry[1]
                var opts *http.PushOptions
                if ct != "" {
                    opts = &http.PushOptions{
                        Header: http.Header{"Content-Type": []string{ct}},
                    }
                }
                _ = pusher.Push(target, opts)
            }
        }

        w.WriteHeader(int(res.Status))

        // ── Body / streaming / SSE. Mutually exclusive: each branch
        //
        //  consumes the connection.
        switch {
        case res.SseHandler != nil:
            // Force a flush of the headers so clients can start reading.
            if fl, ok := w.(http.Flusher); ok {
                fl.Flush()
            }
            emitter := NewSseEmitter()
            emitter.Writer = w
            if fl, ok := w.(http.Flusher); ok {
                emitter.Flusher = fl
            }
            // Run the user-provided emitter loop. callHook gives us
            // panic recovery (so a bad SSE handler doesn't crash the
            // process), but the response is already on the wire so we
            // can't change the status code from here on.
            if fn, ok := res.SseHandler.(func(*SseEmitter)); ok {
                func() {
                    defer func() { _ = recover() }()
                    fn(emitter)
                }()
            }
        case res.StreamHandler != nil:
            if fn, ok := res.StreamHandler.(func(http.ResponseWriter)); ok {
                func() {
                    defer func() { _ = recover() }()
                    fn(w)
                }()
            }
        default:
            io.WriteString(w, res.Body)
        }
    }

    func runErrorHooks(srv *Server, req *Request, res *Response, errVal interface{}) {
        // Route-level error hook fires first (closer to the route)
        // so plugins that wrap a single route see the raw error
        // before the global observers do.
        // The dispatcher stashes the matched route on req.Ctx so
        // recover paths in deferred callbacks can find it.
        if route, ok := req.Ctx.Get("__lamMatchedRoute", nil).(*lamRoute); ok && route != nil &&
            route.opts != nil && route.opts.OnError != nil {
            if fn, ok := route.opts.OnError.(func(*Request, *Response, interface{})); ok {
                func() {
                    defer func() { _ = recover() }()
                    fn(req, res, errVal)
                }()
            }
        }
        for _, h := range srv.OnErrorHooks {
            if fn, ok := h.(func(*Request, *Response, interface{})); ok {
                func() {
                    defer func() { _ = recover() }()
                    fn(req, res, errVal)
                }()
            }
        }
    }

    // lamWriteHttpError serialises a typed *HttpError* / HttpError
    // into the response as “application/problem+json“ with the
    // status, message and (optional) data slots Fastify users
    // expect.
    func lamWriteHttpError(res *Response, he lamHttpErrorView) {
        res.Status = he.Status
        if res.Headers == nil {
            res.Headers = map[string]string{}
        }
        res.Headers["Content-Type"] = "application/json; charset=utf-8"
        msg := he.Message
        if msg == "" {
            msg = http.StatusText(he.Status)
        }
        payload := map[string]interface{}{
            "statusCode": he.Status,
            "error":      http.StatusText(he.Status),
            "message":    msg,
        }
        if he.Data != nil {
            payload["data"] = he.Data
        }
        if b, err := json.Marshal(payload); err == nil {
            res.Body = string(b)
        } else {
            res.Body = fmt.Sprintf(`{"statusCode":%d,"message":%q}`, he.Status, msg)
        }
        res.Sent = true
    }

    // lamHandlePanic centralises panic recovery for hooks/handlers.
    // Order:
    //  1. Run onError observers (they may decide to mutate res).
    //  2. If the panic is a HttpError, render it as JSON (unless an
    //     observer already wrote a response).
    //  3. Otherwise call srv.ErrorHandler if set.
    //  4. Fall back to a generic 500.
    func lamHandlePanic(srv *Server, req *Request, res *Response, rec interface{}) {
        runErrorHooks(srv, req, res, rec)
        if res.Sent {
            return
        }
        if he, ok := lamExtractHttpError(rec); ok {
            lamWriteHttpError(res, he)
            return
        }
        if srv.ErrorHandler != nil {
            if fn, ok := srv.ErrorHandler.(func(interface{}, *Request, *Response)); ok {
                func() {
                    defer func() { _ = recover() }()
                    fn(rec, req, res)
                }()
                if res.Sent {
                    return
                }
            }
        }
        res.Status = 500
        if res.Headers == nil {
            res.Headers = map[string]string{}
        }
        res.Headers["Content-Type"] = "text/plain; charset=utf-8"
        if srv.Debug {
            res.Body = fmt.Sprintf("internal server error: %v", rec)
        } else {
            res.Body = "internal server error"
        }
        res.Sent = true
    }

    func callHook(srv *Server, fn func(*Request, *Response), req *Request, res *Response) {
        defer func() {
            if rec := recover(); rec != nil {
                lamHandlePanic(srv, req, res, rec)
            }
        }()
        fn(req, res)
    }

    func callHandler(srv *Server, fn func(*Request, *Response), req *Request, res *Response) {
        defer func() {
            if rec := recover(); rec != nil {
                lamHandlePanic(srv, req, res, rec)
            }
        }()
        fn(req, res)
    }
}

func main() {
    pass
}
