// modules.sa -- `use` splices a source file, and the file builtins read and
// write it.
//
// Pure-min dialect: seed-min, gen2 and native_aot all accept it.
//
//   ./selfhost/gen2 samples/Sayanox/modules.sa /tmp/m.c
//   cc -O2 -o /tmp/m /tmp/m.c && /tmp/m README.md /tmp/report.txt
//
// `use` is a textual splice, not a namespaced or versioned import, and its
// path is resolved from the directory the compiler runs in -- here the
// repository root, hence "stdlib/tiny.sa" rather than "../../stdlib/tiny.sa".
// Everything the spliced file declares becomes available below this line.

use "stdlib/tiny.sa"

// numeric helpers from the spliced module
show min2(3, 7)
show max2(3, 7)
show clamp(45, 0, 10)
show gcd(1071, 462)
show is_prime(97)
show fib(15)
show digit_sum(9045)
show reverse_num(1234)

// arg 1 is the file to read; `read_file` gives the whole file as a string and
// `len` counts its bytes. String indexing is zero-based.
hold count = arg_count()
when count < 2 {
  show "usage: modules <file> [report-path]"
} otherwise {
  hold path = arg(1)
  hold text = read_file(path)
  show len(text)

  hold first = sx_index(text, 0)
  show first
  show chr(first)

  // count newlines, which is how many lines the file has
  hold lines = 0
  hold i = 0
  while i < len(text) {
    hold c = sx_index(text, i)
    when c == 10 {
      hold lines = lines + 1
    }
    hold i = i + 1
  }
  show lines
  show sum_to(lines)

  // arg 2 is optional: write a fixed report there and read it back.
  // `write_file` truncates and gives a numeric status. Building a message that
  // contains a number needs the gen2 builtin `numstr`; portable code writes a
  // fixed string, because `string + number` is rejected by every backend.
  when count > 2 {
    hold out = arg(2)
    hold status = write_file(out, "report generated by modules.sa\n")
    show status
    hold back = read_file(out)
    show len(back)
  }
}
