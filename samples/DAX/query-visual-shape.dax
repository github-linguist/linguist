// DAX Query
// Generated by Power BI Desktop (Performance Analyzer) for a matrix visual with visual calculations.
DEFINE
  VAR __DS0FilterTable =
    TREATAS({"FY2025"}, 'Date'[Fiscal Year])

  VAR __DS0FilterTable2 =
    FILTER(
      KEEPFILTERS(VALUES('Product'[Category])),
      NOT('Product'[Category] IN {"Accessories", BLANK()})
    )

  VAR __DS0VisualCalcsInput =
    SUMMARIZECOLUMNS(
      ROLLUPADDISSUBTOTAL('Product'[Category], "IsGrandTotalRowTotal"),
      ROLLUPADDISSUBTOTAL('Date'[Month], "IsGrandTotalColumnTotal"),
      __DS0FilterTable,
      __DS0FilterTable2,
      "Sales_Amount", 'Sales'[Sales Amount],
      "Order_Count", CALCULATE(COUNTROWS('Sales'), NONFILTER('Sales'[Status]))
    )

  TABLE '__DS0VisualCalcs' = __DS0VisualCalcsInput
    WITH VISUAL SHAPE
      AXIS ROWS
        GROUP [Category] TOTAL [IsGrandTotalRowTotal]
        ORDER BY [Category] ASC
      AXIS COLUMNS
        GROUP [Month] TOTAL [IsGrandTotalColumnTotal]
        ORDER BY [Month] ASC
      DENSIFY "IsDensifiedRow"

  COLUMN '__DS0VisualCalcs'[Running_Total] = RUNNINGSUM([Sales_Amount], COLUMNS)
  COLUMN '__DS0VisualCalcs'[Share_of_Parent] = DIVIDE([Sales_Amount], COLLAPSE([Sales_Amount], ROWS))
  COLUMN '__DS0VisualCalcs'[Rank_in_Month] = RANK(DENSE, ROWS, ORDERBY([Sales_Amount], DESC), LOWESTPARENT)

  VAR __DS0Core =
    SELECTCOLUMNS(
      KEEPFILTERS(FILTER(KEEPFILTERS('__DS0VisualCalcs'), [IsDensifiedRow] = FALSE())),
      "'Product'[Category]", [Category],
      "'Date'[Month]", [Month],
      "IsGrandTotalRowTotal", [IsGrandTotalRowTotal],
      "IsGrandTotalColumnTotal", [IsGrandTotalColumnTotal],
      "Sales_Amount", [Sales_Amount],
      "Order_Count", [Order_Count],
      "Running_Total", [Running_Total],
      "Share_of_Parent", [Share_of_Parent],
      "Rank_in_Month", [Rank_in_Month]
    )

  VAR __DS0PrimaryWindowed =
    TOPN(502, __DS0Core, [IsGrandTotalRowTotal], 0, 'Product'[Category], 1)

EVALUATE
  __DS0PrimaryWindowed

ORDER BY
  [IsGrandTotalRowTotal] DESC, 'Product'[Category], [IsGrandTotalColumnTotal] DESC, 'Date'[Month]
