fs from fs/promises
path from node:path
{ spawn } from child_process
{
  applyCompilerOption,
  compile,
  makeCompilerOptions,
  parseConfigAssignment,
  version,
} from ./main.civet
{ findInDir, loadConfig } from ./config-file.civet
type { CompilerOptions } from ./types.civet

maxLatexRuns := 5
// If any of these files changes from a latex run, need to rerun latex.
rerunGeneratedExtensions := [
  'brf' // back references
  'loa' // list of algorithms
  'lof' // list of figures
  'lol' // list of listings
  'lot' // list of tables
  'nav' // Beamer navigation data
  'out' // PDF outlines/bookmarks
  'snm' // Beamer slide names
  'thm' // list of theorems
  'toc' // table of contents
  'vrb' // Beamer verbatim frames
]

function usage: void
  console.log ```
    Texlish ${version}
    Usage: texlish [options] filename

    Transpile from .texlish to .tex, and optionally compile with LaTeX.
    If you specify 'filename', we'll try 'filename.texlish' first.
    If you specify 'filename.tex', we'll try 'filename.texlish' first;
    if it doesn't exist, we can still build 'filename.tex' for you.

    To build with LaTeX, use one of the following options:
    --pdf / --pdflatex: Run pdflatex
    --lua / --lualatex: Run lualatex
    --xe / --xelatex: Run xelatex
    --latex / --dvi: Run latex
    These will run LaTeX multiple times and/or bibtex/biber/makeindex as needed.

    Other options:
    --version: Print version number
    --trace=filename: Debug compilation by writing a trace log
    --config key[=value]: Set compiler config (e.g. scriptGrouping=alpha, latexCompat, or -markdownCompat)
    -...: Other LaTeX command-line options are passed on as-is

  ```

function exists(path: string): Promise<boolean>
  try
    await fs.stat path
    return true
  catch
    return false

export function transpile(filename: string, options: CompilerOptions): Promise<string>
  input := await fs.readFile filename, 'utf8'
  output := compile input, {...options, filename}
  |> ```
    % This file was generated by Texlish ${version} <https://github.com/edemaine/texlish/>
    % You should probably edit the .texlish file instead of this one.
    ${&}
  ```
  outFilename := filename.replace /\.texlish$|$/, '.tex'
  await fs.writeFile outFilename, output
  console.log `\n** ${filename} -> ${outFilename}`
  outFilename

export function cli: Promise<void>
  mode .= 'compile'
  flags .= []
  filenames .= []
  options .= makeCompilerOptions()
  try
    if configPath := await findInDir process.cwd()
      options = makeCompilerOptions {
        ...options
        ...await loadConfig configPath
      }
  catch error
    console.log `!! ${error}`
    process.exit 1
    return

  for i .= 2; i < process.argv#; i++
    arg := process.argv[i]
    switch arg
      /^--?help/
        return usage()
      /^--?version$/
        console.log version
        return
      /^--?pdf(latex)?$/
        mode = 'pdflatex'
      /^--?(dvi|latex)?$/
        mode = 'latex'
      /^--?lua(latex)?$/
        mode = 'lualatex'
      /^--?xe((la)?tex)?$/
        mode = 'xelatex'
      /^--?trace=/
        options.trace = arg[arg.indexOf('=')+1..]
      /^--?config=/
        try
          { key, value } := parseConfigAssignment arg[arg.indexOf('=')+1..]
          applyCompilerOption options, key, value
        catch error
          console.log `!! ${error}`
          process.exit 1
          return
      /^--?config$/
        unless configArg := process.argv[++i]
          console.log "!! Missing value after --config"
          process.exit 1
          return
        try
          { key, value } := parseConfigAssignment configArg
          applyCompilerOption options, key, value
        catch error
          console.log `!! ${error}`
          process.exit 1
          return
      // LaTeX command-line option that takes a value
      /^--?(output-directory|aux-directory|auxdir|jobname)$/
        flags.push arg
        unless flagValue := process.argv[++i]
          console.log `!! Missing value after ${arg}`
          process.exit 1
          return
        flags.push flagValue
      /^-/  // LaTeX command-line option
        flags.push arg
      else
        filenames.push arg

  return usage() unless filenames#

  errors .= 0
  for each filename of filenames
    let texFile: string
    if await exists filename + '.texlish'
      texFile = await transpile filename + '.texlish', options
    else if filename.toLowerCase().endsWith '.texlish'
      unless await exists filename
        console.log `!! Ignoring missing file: ${filename}`
        errors++
        continue
      texFile = await transpile filename, options
    else if await exists filename + '.tex'
      texFile = filename + '.tex'
    else if filename.toLowerCase().endsWith '.tex'
      if await exists filename[< -4] + '.texlish'
        texFile = await transpile filename[< -4] + '.texlish', options
      else
        texFile = filename
        unless await exists texFile
          console.log `!! Ignoring missing file: ${texFile}`
          errors++
          continue
    else
      console.log `!! Ignoring unknown file: ${filename}`
      errors++
      continue

    unless mode is 'compile'
      errors += await buildLatex mode, flags, texFile

  process.exit Math.min 255, errors

export function posixQuote(arg: string): string
  return arg if /^[A-Za-z0-9_\/.-]+$/.test arg
  // Escape single quotes by closing, escaping, and reopening single quotes
  `'${arg.replace /'/g, "'\\''"}'`

export function buildLatex(command: string, flags: string[], texFile: string): Promise<number>
  workDir := path.dirname texFile
  texBase := path.basename texFile
  jobName := latexFlagValue(flags, ['jobname']) ?? path.basename texBase, path.extname texBase
  rawOutputDir := latexFlagValue flags, ['output-directory']
  outputDir := latexDir workDir, rawOutputDir
  artifactDir := latexDir workDir,
    latexFlagValue(flags, ['aux-directory', 'auxdir']) ?? rawOutputDir
  outputFile := path.join outputDir, `${jobName}${command is 'latex' ? '.dvi' : '.pdf'}`

  function artifact(ext: string): string
    path.join artifactDir, `${jobName}.${ext}`
  function relative(filename: string): string
    if path.isAbsolute filename
      path.relative workDir, filename
    else
      filename
  async function snapshotGeneratedFiles(): Promise Map string, string?
    snapshot := new Map<string, string?>
    for each ext of rerunGeneratedExtensions
      filename := artifact ext
      snapshot.set filename, await readTextIfExists filename
    snapshot
  async function bibtexInput(auxFilename: string, seen = new Set<string>): Promise string
    // Canonicalize for cycle/dedup tracking; child paths are resolved below.
    resolved := path.resolve auxFilename
    return `\\@input{${resolved}}\n` if seen.has resolved
    seen.add resolved
    aux := await readTextIfExists auxFilename
    return `\\@missing{${resolved}}\n` unless aux?
    input .= ''
    for [match, command, arg] of aux.matchAll /\\(@input|citation|bibdata|bibstyle)\{([^}]*)\}/g
      input += `${match}\n`
      if command is '@input'
        input += await bibtexInput path.resolve(path.dirname(auxFilename), arg), seen
    input

  latexRuns .= 0
  runReason .= 'initial'
  commandsRun .= []
  ranMakeindex .= false
  // false marks that no bib command has run yet; undefined means "no file"
  lastBibInput: string? | false .= false
  let bblBefore: string? // .bbl file contents from last bib run, if any
  loop
    if ++latexRuns > maxLatexRuns
      console.log `!! Stopping LaTeX build after ${maxLatexRuns} runs`
      return 1

    auxBefore := await readTextIfExists artifact 'aux'
    idxBefore := await readTextIfExists artifact 'idx'
    generatedBefore := await snapshotGeneratedFiles()
    latexError := await runCommand command, [
      ...flags
      texBase
    ], workDir
    return latexError if latexError
    commandsRun.push command
    auxAfter := await readTextIfExists artifact 'aux'

    if bibCommand := (
      // BibLaTeX with backend=bibtex writes \bibdata and \abx@aux@, but no .bcf.
      // BibLaTeX with backend=biber writes \abx@aux@ and .bcf, but no \bibdata.
      if auxAfter is like /\\bibdata\{/
        'bibtex'
      else if auxAfter is like /\\abx@aux@/ and await exists artifact 'bcf'
        'biber'
    )
      bblBefore ?= await readTextIfExists artifact 'bbl'
      bibInput := if bibCommand is 'bibtex'
        await bibtexInput artifact 'aux'
      else
        await readTextIfExists artifact 'bcf'
      if bibInput is not lastBibInput or not bblBefore?
        bibError := await runCommand bibCommand, [
          relative path.join artifactDir, jobName
        ], workDir
        commandsRun.push bibCommand
        bblAfter := await readTextIfExists artifact 'bbl'
        if bibError
          // Restore bbl file if BibTeX/Biber failed, e.g. from missing bib files
          if bblAfter? and not /\\(?:bibitem|entry)\b/.test bblAfter
            if bblBefore?
              await fs.writeFile artifact('bbl'), bblBefore
            else
              await fs.rm artifact('bbl'), force: true
          return bibError
        lastBibInput = bibInput
        if bblBefore is not bblAfter
          bblBefore = bblAfter
          runReason = 'bbl-changed'
          continue

    idxAfter := await readTextIfExists artifact 'idx'
    if idxAfter and (not ranMakeindex or idxBefore is not idxAfter)
      indBefore := await readTextIfExists artifact 'ind'
      makeindexError := await runCommand 'makeindex', [
        '-o'
        relative artifact 'ind'
        relative artifact 'idx'
      ], workDir
      return makeindexError if makeindexError
      commandsRun.push 'makeindex'
      ranMakeindex = true
      indAfter := await readTextIfExists artifact 'ind'
      if indBefore is not indAfter
        runReason = 'index-changed'
        continue

    generatedAfter := await snapshotGeneratedFiles()
    if generatedFilesChanged generatedBefore, generatedAfter
      runReason = 'generated-changed'
      continue

    logAfter := await readTextIfExists artifact 'log'
    if logAfter?.includes 'LaTeX Warning: Label(s) may have changed. Rerun to get cross-references right.'
      // Ignore second label-warning if aux file didn't actually change.
      break if runReason is 'label-warning' and auxBefore is auxAfter
      runReason = 'label-warning'
      continue

    break // stop loop if no runReason to continue

  console.log `\n** ${relative outputFile} built via ${commandsRun.join ', '}`
  return 0

function latexDir(workDir: string, dir: string?): string
  dir ? path.resolve(workDir, dir) : workDir

function latexFlagValue(flags: string[], names: string[]): string?
  for each flag, i of flags
    for each name of names
      for each option of [`-${name}`, `--${name}`]
        return flag[flag.indexOf('=') + 1..] if flag.startsWith `${option}=`
        return flags[i + 1] if flag is option and flags[i + 1]
  return

function readTextIfExists(filename: string): Promise<string?>
  try
    await fs.readFile filename, 'utf8'
  catch error
    if (error as NodeJS.ErrnoException).code is 'ENOENT'
      return
    else
      throw error

function generatedFilesChanged(before: Map<string, string?>, after: Map<string, string?>): boolean
  for some filename of new Set [ ...before.keys(), ...after.keys() ]
    before.get(filename) is not after.get(filename)

function runCommand(command: string, args: string[], cwd?: string): Promise<number>
  commandLine .= `${command} ${args.map(posixQuote).join ' '}`
  if cwd and cwd is not '.'
    commandLine = `cd ${posixQuote cwd}; ${commandLine}`
  console.log `\n** ${commandLine}`
  try
    await spawnCommand command, args, cwd
  catch error
    if process.platform is 'win32' and (error as NodeJS.ErrnoException).code is 'ENOENT'
      // Cygwin pdflatex is a symlink and can be run only within Cygwin bash
      try
        await spawnCommand 'bash', [
          '-c'
          `exec ${[command, ...args].map(posixQuote).join ' '}`
        ], cwd
      catch error2
        console.log "** FAILED:", error
        console.log "** BASH ALSO FAILED:", error2
        1
    else
      console.log "** FAILED:", error
      1

function spawnCommand(command: string, args: string[], cwd = process.cwd()): Promise<number>
  new Promise<number> (resolve, reject): void =>
    errored .= false
    spawn command, args, {}
      stdio: 'inherit'
      cwd
    ||> .on 'error', (error) =>
      errored = true
      reject error
    ||> .on 'close', (code) =>
      return if errored
      if code
        console.log "** ERROR CODE:", code
        resolve 1
      else
        resolve 0
